# Copie para .env e ajuste os valores. O .env nunca vai para o repositório.
#
# Este arquivo documenta TODA variável que o código lê. Existe teste cobrando
# isso (`test/unit/ambienteDeConteiner.test.js`): variável nova sem linha aqui
# reprova a suíte.

NODE_ENV=development
PORT=3000

# Banco de dados MySQL 8
# Rodando pelo docker-compose, o host passa a ser `mysql`, que é o nome do
# serviço — o compose já faz essa troca sozinho.
DB_HOST=localhost
DB_PORT=3306
DB_USER=beever
DB_PASSWORD=beever
DB_NAME=beever
# Vinte é o número medido na T-14.3 para 30 jogadores simultâneos.
# Ver docs/16-MEDICAO-DE-CARGA.md antes de mexer.
DB_POOL_LIMIT=20

# Senha do root do MySQL do docker-compose. Só o contêiner do banco usa: a
# aplicação entra com DB_USER, que não tem privilégio de administração.
DB_ROOT_PASSWORD=root

# Sessão de login. Em produção, gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-segredo-gere-com-openssl-rand-base64-48
SESSION_MAX_AGE_MINUTES=20

# Nível de log do pino: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# E-mail publicado na política de privacidade para pedidos de acesso e exclusão
# de dados (Art. 18 da LGPD). Em produção precisa ser um endereço que alguém lê.
CONTACT_EMAIL=contato@beever.local

# Endereço público da aplicação, usado nos links enviados por e-mail.
APP_URL=http://localhost:3000

# Envio de e-mail (recuperação de senha). Em desenvolvimento os valores abaixo
# apontam para o Mailpit do docker-compose, que mostra os e-mails em
# http://localhost:8025 sem enviar nada. Em produção use um SMTP real (Gmail com
# senha de app, Brevo) — porta 465 liga TLS direto, as outras usam STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Beever <nao-responda@beever.local>

# Login com Google (opcional). Crie um "ID do cliente OAuth" do tipo aplicativo
# da Web no Google Cloud Console, com o URI de redirecionamento
# ${APP_URL}/sessao/google/retorno. Vazio, o botão do Google não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jenkins local (`docker compose --profile jenkins up -d`, em http://localhost:8080).
# O usuário é `admin` e a senha abaixo só serve para o Jenkins local, que escuta
# apenas em 127.0.0.1; troque se a máquina for compartilhada. Sem senha o
# contêiner recusa subir. DOCKER_GID é o grupo dono do socket do Docker no
# host: descubra com `getent group docker`. Detalhes em docs/29-JENKINS.md.
JENKINS_ADMIN_PASSWORD=beever-jenkins
DOCKER_GID=999

# Ilustrações enviadas pelo painel administrativo. Qualquer formato de imagem é
# aceito no envio e convertido para WebP antes de gravar. Em contêiner, esta
# pasta precisa ser um volume: sem isso a arte some no próximo deploy.
UPLOADS_DIR=uploads
UPLOAD_MAX_MB=8

# Backup (`npm run db:backup`). Quando não há `mysqldump` na máquina, o script
# usa o do contêiner nomeado abaixo. A retenção apaga dump mais velho que isso.
BACKUP_CONTAINER=mysql
BACKUP_RETENCAO_DIAS=7

# Endereço que o `npm run evidencias` visita para fotografar as telas. Precisa
# ser a aplicação já de pé: o script abre o navegador, não sobe o servidor.
EVIDENCIAS_URL=http://localhost:3000

# Qual conta do seed o `npm run evidencias` fotografa: `demo` é a Ana, que mostra
# o começo do jogo, e `avancado` é o Léo, que só existe com `npm run db:seed:demo`.
EVIDENCIAS_CONTA=demo
