<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Processo_Compra" targetNamespace="https://github.com/Razawaky/Beever">
  <bpmn:collaboration id="Colaboracao_Processo_Compra">
    <bpmn:participant id="Pool_Processo_Compra" name="Beever — comprar na loja" processRef="Processo_Compra" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_Compra" isExecutable="false">
    <bpmn:laneSet id="Lanes_Processo_Compra">
      <bpmn:lane id="Lane_Jogador" name="Jogador (navegador)">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Escolhe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VeItem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Servidor" name="Servidor (services e MySQL)">
        <bpmn:flowNodeRef>Vitrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwChave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DevolveCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwSaldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FimRecusada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Debita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Audita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwJunta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Jogador abre a loja">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Vitrine" name="Monta a vitrine com preço, requisitos e prévia">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Escolhe" name="Escolhe um item e confirma">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GwChave" name="A chave da compra já foi usada?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="DevolveCompra" name="Devolve a compra já feita, sem cobrar de novo">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GwSaldo" name="Mel e requisitos suficientes?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FimRecusada" name="Recusa com o motivo">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:transaction id="Debita" name="Debita o mel, grava a compra e entrega o item">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:transaction>
    <bpmn:task id="Audita" name="Registra a auditoria com o saldo antes e depois">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GwJunta" name="">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="VeItem" name="Vê o item no inventário">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fim" name="Item no inventário">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="Vitrine" />
    <bpmn:sequenceFlow id="F2" sourceRef="Vitrine" targetRef="Escolhe" />
    <bpmn:sequenceFlow id="F3" sourceRef="Escolhe" targetRef="GwChave" />
    <bpmn:sequenceFlow id="F4" name="sim" sourceRef="GwChave" targetRef="DevolveCompra" />
    <bpmn:sequenceFlow id="F5" name="não" sourceRef="GwChave" targetRef="GwSaldo" />
    <bpmn:sequenceFlow id="F6" name="não" sourceRef="GwSaldo" targetRef="FimRecusada" />
    <bpmn:sequenceFlow id="F7" name="sim" sourceRef="GwSaldo" targetRef="Debita" />
    <bpmn:sequenceFlow id="F8" sourceRef="Debita" targetRef="Audita" />
    <bpmn:sequenceFlow id="F9" sourceRef="Audita" targetRef="GwJunta" />
    <bpmn:sequenceFlow id="F10" sourceRef="DevolveCompra" targetRef="GwJunta" />
    <bpmn:sequenceFlow id="F11" sourceRef="GwJunta" targetRef="VeItem" />
    <bpmn:sequenceFlow id="F12" sourceRef="VeItem" targetRef="Fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Processo_Compra">
    <bpmndi:BPMNPlane id="Plano_Processo_Compra" bpmnElement="Colaboracao_Processo_Compra">
      <bpmndi:BPMNShape id="Pool_Processo_Compra_di" bpmnElement="Pool_Processo_Compra" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1580" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Jogador_di" bpmnElement="Lane_Jogador" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1550" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Servidor_di" bpmnElement="Lane_Servidor" isHorizontal="true">
        <dc:Bounds x="190" y="240" width="1550" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio">
        <dc:Bounds x="292" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="255" y="184" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Vitrine_di" bpmnElement="Vitrine">
        <dc:Bounds x="395" y="260" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escolhe_di" bpmnElement="Escolhe">
        <dc:Bounds x="535" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwChave_di" bpmnElement="GwChave" isMarkerVisible="true">
        <dc:Bounds x="705" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="598" y="245" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DevolveCompra_di" bpmnElement="DevolveCompra">
        <dc:Bounds x="815" y="470" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwSaldo_di" bpmnElement="GwSaldo" isMarkerVisible="true">
        <dc:Bounds x="845" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="738" y="245" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FimRecusada_di" bpmnElement="FimRecusada">
        <dc:Bounds x="992" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="955" y="434" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Debita_di" bpmnElement="Debita" isExpanded="false">
        <dc:Bounds x="950" y="255" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Audita_di" bpmnElement="Audita">
        <dc:Bounds x="1095" y="260" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwJunta_di" bpmnElement="GwJunta" isMarkerVisible="true">
        <dc:Bounds x="1265" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="VeItem_di" bpmnElement="VeItem">
        <dc:Bounds x="1375" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fim_di" bpmnElement="Fim">
        <dc:Bounds x="1552" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1515" y="184" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="328" y="160" />
        <di:waypoint x="450" y="160" />
        <di:waypoint x="450" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="505" y="300" />
        <di:waypoint x="590" y="300" />
        <di:waypoint x="590" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="645" y="160" />
        <di:waypoint x="730" y="160" />
        <di:waypoint x="730" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="730" y="325" />
        <di:waypoint x="730" y="510" />
        <di:waypoint x="815" y="510" />
        <bpmndi:BPMNLabel><dc:Bounds x="686" y="410" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="755" y="300" />
        <di:waypoint x="845" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="785" y="304" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="870" y="325" />
        <di:waypoint x="870" y="410" />
        <di:waypoint x="992" y="410" />
        <bpmndi:BPMNLabel><dc:Bounds x="826" y="360" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="895" y="300" />
        <di:waypoint x="950" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="304" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1070" y="300" />
        <di:waypoint x="1095" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1205" y="300" />
        <di:waypoint x="1265" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="925" y="510" />
        <di:waypoint x="1290" y="510" />
        <di:waypoint x="1290" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="1315" y="300" />
        <di:waypoint x="1430" y="300" />
        <di:waypoint x="1430" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="1485" y="160" />
        <di:waypoint x="1552" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
