        <bpmndi:BPMNLabel><dc:Bounds x="966" y="170" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1035" y="255" />
        <di:waypoint x="1095" y="255" />
        <bpmndi:BPMNLabel><dc:Bounds x="1050" y="259" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1205" y="255" />
        <di:waypoint x="1290" y="255" />
        <di:waypoint x="1290" y="355" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1290" y="405" />
        <di:waypoint x="1290" y="490" />
