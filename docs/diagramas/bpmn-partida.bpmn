        <dc:Bounds x="1375" y="340" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Credita_di" bpmnElement="Credita" isExpanded="false">
        <dc:Bounds x="1510" y="335" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Registra_di" bpmnElement="Registra">
        <dc:Bounds x="1655" y="340" width="110" height="80" />
