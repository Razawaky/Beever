<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Processo_Partida" targetNamespace="https://github.com/Razawaky/Beever">
  <bpmn:collaboration id="Colaboracao_Processo_Partida">
    <bpmn:participant id="Pool_Processo_Partida" name="Beever — jogar uma célula" processRef="Processo_Partida" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_Partida" isExecutable="false">
    <bpmn:laneSet id="Lanes_Processo_Partida">
      <bpmn:lane id="Lane_Jogador" name="Jogador (navegador)">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EscolheCelula</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Joga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwConclui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FimAbandonada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnviaRespostas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VeResultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Servidor" name="Servidor (services e MySQL)">
        <bpmn:flowNodeRef>GwLiberada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FimTravada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AbrePartida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwFechada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DevolveGravado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Credita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwJunta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Jogador abre a trilha">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="EscolheCelula" name="Escolhe uma célula">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GwLiberada" name="A célula está liberada?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FimTravada" name="Recusa com o motivo do bloqueio">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="AbrePartida" name="Abre a partida, retomando a que estava aberta, e gera o token">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Joga" name="Joga a atividade (quiz ou arrastar)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GwConclui" name="Concluiu ou desistiu?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FimAbandonada" name="Partida abandonada, sem recompensa">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="EnviaRespostas" name="Envia só as respostas">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GwFechada" name="O token já foi fechado?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="DevolveGravado" name="Devolve o resultado gravado, sem pagar de novo">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Corrige" name="Corrige as respostas pelo gabarito do banco">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:transaction id="Credita" name="Credita XP, pólen e mel numa transação">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:transaction>
    <bpmn:task id="Registra" name="Registra a auditoria, conta o dia e avalia conquistas">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GwJunta" name="">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="VeResultado" name="Vê estrelas, recompensas e conquistas">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fim" name="Mel no saldo e próxima célula liberada">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="EscolheCelula" />
    <bpmn:sequenceFlow id="F2" sourceRef="EscolheCelula" targetRef="GwLiberada" />
    <bpmn:sequenceFlow id="F3" name="não" sourceRef="GwLiberada" targetRef="FimTravada" />
    <bpmn:sequenceFlow id="F4" name="sim" sourceRef="GwLiberada" targetRef="AbrePartida" />
    <bpmn:sequenceFlow id="F5" sourceRef="AbrePartida" targetRef="Joga" />
    <bpmn:sequenceFlow id="F6" sourceRef="Joga" targetRef="GwConclui" />
    <bpmn:sequenceFlow id="F7" name="desistiu" sourceRef="GwConclui" targetRef="FimAbandonada" />
    <bpmn:sequenceFlow id="F8" name="concluiu" sourceRef="GwConclui" targetRef="EnviaRespostas" />
    <bpmn:sequenceFlow id="F9" sourceRef="EnviaRespostas" targetRef="GwFechada" />
    <bpmn:sequenceFlow id="F10" name="sim" sourceRef="GwFechada" targetRef="DevolveGravado" />
    <bpmn:sequenceFlow id="F11" name="não" sourceRef="GwFechada" targetRef="Corrige" />
    <bpmn:sequenceFlow id="F12" sourceRef="Corrige" targetRef="Credita" />
    <bpmn:sequenceFlow id="F13" sourceRef="Credita" targetRef="Registra" />
    <bpmn:sequenceFlow id="F14" sourceRef="Registra" targetRef="GwJunta" />
    <bpmn:sequenceFlow id="F15" sourceRef="DevolveGravado" targetRef="GwJunta" />
    <bpmn:sequenceFlow id="F16" sourceRef="GwJunta" targetRef="VeResultado" />
    <bpmn:sequenceFlow id="F17" sourceRef="VeResultado" targetRef="Fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Processo_Partida">
    <bpmndi:BPMNPlane id="Plano_Processo_Partida" bpmnElement="Colaboracao_Processo_Partida">
      <bpmndi:BPMNShape id="Pool_Processo_Partida_di" bpmnElement="Pool_Processo_Partida" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2140" height="470" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Jogador_di" bpmnElement="Lane_Jogador" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2110" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Servidor_di" bpmnElement="Lane_Servidor" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="2110" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio">
        <dc:Bounds x="292" y="237" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="255" y="279" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EscolheCelula_di" bpmnElement="EscolheCelula">
        <dc:Bounds x="395" y="215" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwLiberada_di" bpmnElement="GwLiberada" isMarkerVisible="true">
