      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EnviaRespostas_di" bpmnElement="EnviaRespostas">
        <dc:Bounds x="1095" y="215" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwFechada_di" bpmnElement="GwFechada" isMarkerVisible="true">
        <dc:Bounds x="1265" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1158" y="325" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
