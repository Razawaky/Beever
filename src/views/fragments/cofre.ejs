<%#
  O miolo do cofre (RF-COF-01 a 04): guardar, tirar, ver o extrato, declarar a
  meta e enxergar a projeção. A página `/cofre` e a seção `/painel/cofre`
  mostram o mesmo conteúdo; o que muda é só a casca em volta.

  `comTitulo` existe porque a página já traz o título no cabeçalho e o painel
  precisa dele dentro da `<main>`. `acaoDoFiltro` mantém a projeção na casca em
  que o formulário foi aberto.

  A partir de `lg` as quatro seções param de competir em pilha: as que pedem
  ação ficam à esquerda, as que só mostram números ficam à direita.
-%>
<%
  const mostrarTitulo = locals.comTitulo !== false;
  const acaoDoFiltro = locals.acaoDoFiltro ?? '/cofre';
  const voltarPara = locals.voltarPara ?? '/cofre';
%>

<% if (mostrarTitulo) { %>
  <h2 class="font-display text-2xl font-bold text-tinta">Meu cofre</h2>
<% } %>

<div class="<%= mostrarTitulo ? 'mt-6 ' : '' %>lg:grid lg:grid-cols-2 lg:items-start lg:gap-8">
  <div>
    <section class="rounded-favo bg-white p-6 shadow-md">
      <%- include('../partials/ui/badge-recurso', {
        icone: '🍯',
        rotulo: 'Guardado no cofre',
        valor: cofre.saldo,
        grande: true,
      }) %>
      <p class="mt-2 text-sm text-tinta-suave">
        Rende <%= cofre.taxaPercentual %>% por semana. Mel que você tira não rende na semana da retirada.
      </p>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <form method="POST" action="/cofre/depositos" class="grid gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="voltarPara" value="<%= voltarPara %>" />
          <label for="valor-deposito" class="text-sm font-semibold">Guardar mel</label>
          <input
            id="valor-deposito"
            name="valor"
            type="number"
            min="1"
            max="<%= perfil.mel %>"
            required
            class="rounded-favo border border-linha px-4 py-2 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
          />
          <%- include('../partials/ui/botao', { texto: 'Guardar', tipo: 'submit', tamanho: 'medio' }) %>
        </form>

        <form method="POST" action="/cofre/saques" class="grid gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="voltarPara" value="<%= voltarPara %>" />
          <label for="valor-saque" class="text-sm font-semibold">Tirar mel</label>
          <input
            id="valor-saque"
            name="valor"
            type="number"
            min="1"
            max="<%= cofre.saldo %>"
            required
            class="rounded-favo border border-linha px-4 py-2 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
          />
          <button
            type="submit"
            class="min-h-11 rounded-favo bg-cera px-4 py-2 font-semibold text-tinta shadow-md transition hover:bg-white hover:shadow-lg focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
          >
            Tirar
          </button>
        </form>
      </div>
    </section>

    <section class="mt-8 rounded-favo bg-white p-6 shadow-md">
      <h2 class="font-display text-xl">Minha meta</h2>

      <% if (cofre.meta) { %>
        <p class="mt-2 text-sm">
          Você quer juntar <strong>🍯 <%= cofre.meta.valor %></strong><% if (cofre.meta.prazo) { %>
            até <%= new Date(cofre.meta.prazo).toLocaleDateString('pt-BR') %><% } %>.
        </p>
        <% if (cofre.semanasParaAMeta !== null) { %>
          <p class="mt-1 text-sm text-tinta-suave">
            Nesse ritmo, faltam <%= cofre.semanasParaAMeta %> <%= cofre.semanasParaAMeta === 1 ? 'semana' : 'semanas' %>.
          </p>
        <% } %>
      <% } else { %>
        <p class="mt-2 text-sm text-tinta-suave">Você ainda não tem uma meta. Quem tem meta guarda mais.</p>
      <% } %>

      <%# Os três campos da meta só cabem lado a lado em largura inteira. A partir
          de `lg` a seção é meia coluna em qualquer tela, então ficam dois. %>
      <form method="POST" action="/cofre/meta" class="mt-4 grid gap-3 sm:grid-cols-3 sm:items-end lg:grid-cols-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="voltarPara" value="<%= voltarPara %>" />
        <div class="grid gap-2">
          <label for="valor-meta" class="text-sm font-semibold">Quero juntar</label>
          <input
            id="valor-meta"
            name="valor"
            type="number"
            min="1"
            value="<%= cofre.meta ? cofre.meta.valor : '' %>"
            class="rounded-favo border border-linha px-4 py-2 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
          />
        </div>
        <div class="grid gap-2">
          <label for="prazo-meta" class="text-sm font-semibold">Até quando</label>
          <input
            id="prazo-meta"
            name="prazo"
            type="date"
            class="rounded-favo border border-linha px-4 py-2 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
          />
        </div>
        <%- include('../partials/ui/botao', { texto: 'Salvar meta', tipo: 'submit', tamanho: 'medio' }) %>
      </form>
    </section>
  </div>

  <div>
    <section class="mt-8 rounded-favo bg-white p-6 shadow-md lg:mt-0">
      <h2 class="font-display text-xl">Se você guardar todo mês</h2>

      <form method="GET" action="<%= acaoDoFiltro %>" class="mt-4 flex flex-wrap items-end gap-3">
        <div class="grid gap-2">
          <label for="por-semana" class="text-sm font-semibold">Guardando por semana</label>
          <input
            id="por-semana"
            name="porSemana"
            type="number"
            min="0"
            value="<%= porSemana %>"
            class="rounded-favo border border-linha px-4 py-2 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
          />
        </div>
        <button
          type="submit"
          class="min-h-11 rounded-favo bg-cera px-4 py-2 font-semibold text-tinta shadow-md transition hover:bg-white hover:shadow-lg focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
        >
          Ver projeção
        </button>
      </form>

      <%
        const projecao = cofre.projecao;
        const ultima = projecao[projecao.length - 1];
      %>
      <p class="mt-4 text-sm">
        Guardando <strong><%= porSemana %></strong> de mel por semana, em
        <strong><%= projecao.length %></strong> semanas você terá <strong>🍯 <%= ultima ? ultima.total : cofre.saldo %></strong>.
      </p>

      <canvas
        class="grafico-linha mt-4"
        width="640"
        height="200"
        role="img"
        aria-label="Projeção do cofre semana a semana, de <%= cofre.saldo %> a <%= ultima ? ultima.total : cofre.saldo %> de mel"
        data-grafico="projecao"
        data-saldo="<%= cofre.saldo %>"
        data-totais="<%= projecao.map((linha) => linha.total).join(',') %>"
      ></canvas>

      <%# Duas colunas de semana só cabem quando a seção tem largura inteira; em
          meia coluna elas colam e viram uma linha só de números. %>
      <ol class="mt-4 grid gap-x-8 gap-y-1 text-sm tabular-nums sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <% projecao.forEach((linha) => { %>
          <li class="flex justify-between border-b border-linha py-1">
            <span class="text-tinta-suave">Semana <%= linha.semana %></span>
            <span class="font-medium">🍯 <%= linha.total %></span>
          </li>
        <% }) %>
      </ol>
    </section>

    <section class="mt-8 rounded-favo bg-white p-6 shadow-md">
      <h2 class="font-display text-xl">Extrato</h2>

      <% if (cofre.extrato.length === 0) { %>
        <p class="mt-2 text-sm text-tinta-suave">Nada aconteceu por aqui ainda.</p>
      <% } else { %>
        <ul class="mt-4 grid gap-2 text-sm tabular-nums">
          <% cofre.extrato.forEach((linha) => { %>
            <li class="flex items-center justify-between gap-3 border-b border-linha py-2">
              <span><%= linha.tipo_nome %></span>
              <span class="text-tinta-suave"><%= new Date(linha.created_at).toLocaleDateString('pt-BR') %></span>
              <span class="font-semibold"><%= linha.tipo === 'saque' ? '−' : '+' %><%= linha.amount %></span>
              <span class="text-tinta-suave">saldo: <%= linha.balance_after %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
</div>
