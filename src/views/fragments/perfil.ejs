<%
  const TagDoTitulo = locals.nivelTitulo === 2 ? 'h2' : 'h1';
  // Dentro da Colmeia o perfil já chega embrulhado pelo bloco branco da seção.
  // Sem esta saída, o cartão branco do perfil viraria um cartão dentro de outro.
  const emBloco = locals.emBloco === true;
  // O catálogo vem do banco, igual ao do onboarding: sem upload e sem lista
  // paralela no JavaScript da tela.
  const opcoesDeAvatar = locals.avatares ?? [];
%>

<div class="mx-auto max-w-3xl">
  <div class="overflow-hidden rounded-favo <%= emBloco ? '' : 'bg-white shadow-xl' %>">
    <div class="flex items-center gap-4 bg-mel px-8 py-8">
      <% if (perfil.avatar_imagem) { %>
        <img
          id="avatar-atual"
          data-avatar-atual
          src="<%= perfil.avatar_imagem %>"
          alt=""
          width="64"
          height="64"
          class="h-16 w-16 object-contain"
        />
      <% } else { %>
        <div
          id="avatar-atual"
          data-avatar-atual
          class="flex h-16 w-16 items-center justify-center rounded-pilula bg-white/40 text-2xl font-bold"
        >
          <%= perfil.apelido.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <div>
        <<%= TagDoTitulo %> class="text-2xl font-bold text-tinta sm:text-3xl"><%= perfil.apelido %></<%= TagDoTitulo %>>
        <p class="text-sm text-tinta-suave">
          Nível <%= perfil.nivel?.nivel ?? 1 %> ·
          sessões de <%= perfil.session_minutes %> minutos ·
          <%= perfil.faixa_etaria_nome ?? 'faixa não definida' %>
        </p>
      </div>
    </div>

    <div class="p-8">
      <section class="rounded-favo bg-cera p-6">
        <h2 class="text-lg font-semibold">Minha imagem</h2>
        <p class="mt-1 text-sm text-tinta-suave">Escolha uma das abelhas do Beever. Sua escolha é salva na hora.</p>

        <form id="form-avatar" class="mt-4" data-perfil-id="<%= perfil.id %>">
          <fieldset>
            <legend class="sr-only">Escolha sua imagem de perfil</legend>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
              <% opcoesDeAvatar.forEach((opcao) => { %>
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="avatar"
                    value="<%= opcao.valor %>"
                    data-imagem="<%= opcao.imagem %>"
                    class="peer sr-only"
                    <%= perfil.avatar === opcao.valor ? 'checked' : '' %>
                  />
                  <span
                    class="flex min-h-24 flex-col items-center justify-center gap-1 rounded-favo border-2 border-linha bg-white p-2 text-center transition hover:border-ambar peer-checked:border-mel peer-checked:bg-mel/20 peer-focus-visible:outline-[3px] peer-focus-visible:outline-ambar peer-focus-visible:outline-offset-2"
                  >
                    <img
                      src="<%= opcao.imagem %>"
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                      class="h-12 w-12 object-contain"
                    />
                    <span class="text-xs font-semibold leading-tight text-tinta"><%= opcao.rotulo %></span>
                  </span>
                </label>
              <% }) %>
            </div>
          </fieldset>

          <p
            id="aviso-avatar"
            role="status"
            aria-live="polite"
            class="mt-4 hidden rounded-lg bg-white px-4 py-3 text-sm"
          ></p>
        </form>
      </section>

      <section class="mt-6 rounded-favo bg-cera p-6">
        <h2 class="text-lg font-semibold">Meus dias de jogo</h2>

        <form id="form-disponibilidade" class="mt-6" data-perfil-id="<%= perfil.id %>">
          <fieldset class="grid gap-3 sm:grid-cols-2">
            <legend class="sr-only">Dias da semana disponíveis</legend>
            <% semana.forEach((dia) => { %>
              <label class="flex cursor-pointer items-center gap-3 rounded-favo border-2 p-4 hover:border-ambar <%= dia.disponivel ? 'border-mel bg-white' : 'border-linha' %>">
                <input
                  type="checkbox"
                  name="dias"
                  class="h-4 w-4"
                  value="<%= dia.diaSemana %>"
                  <%= dia.disponivel ? 'checked' : '' %>
                />
                <span class="font-medium capitalize"><%= dia.nome %></span>
              </label>
            <% }) %>
          </fieldset>

          <%# O resultado de salvar aparece por JavaScript. Sem `role="status"`,
              quem usa leitor de tela trocaria a semana sem ouvir o que mudou. %>
          <p
            id="aviso-disponibilidade"
            role="status"
            aria-live="polite"
            class="mt-4 hidden rounded-lg bg-white px-4 py-3 text-sm"
          ></p>

          <div class="mt-6 flex items-center gap-4">
            <%- include('../partials/ui/botao', {
              texto: 'Salvar meus dias',
              tipo: 'submit',
              id: 'btn-salvar-dias',
              formato: 'pilula',
            }) %>
            <a href="/painel" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4">
              Voltar ao painel
            </a>
          </div>
        </form>
      </section>

      <section class="mt-6 rounded-favo bg-cera p-6">
        <h2 class="text-lg font-semibold">Minhas metas agora</h2>
        <% if (metas.length === 0) { %>
          <p class="mt-2 text-sm text-tinta-suave">Nenhuma meta ativa no momento.</p>
        <% } else { %>
          <ul class="mt-4 grid gap-3">
            <% metas.forEach((meta) => { %>
              <%
                const alvo = Number(meta.target_value) || 1;
                const percentual = Math.min(100, Math.round((Number(meta.current_value) / alvo) * 100));
              %>
              <li class="rounded-lg bg-white px-4 py-3">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-medium"><%= meta.title %></span>
                  <span class="text-sm text-tinta-suave"><%= meta.current_value %> de <%= meta.target_value %></span>
                </div>
                <div
                  class="mt-2 h-2 overflow-hidden rounded-pilula bg-cera"
                  role="progressbar"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="<%= percentual %>"
                  aria-label="Progresso da meta <%= meta.title %>"
                >
                  <div class="h-full rounded-pilula bg-mel <%= classeDaBarra(percentual) %>"></div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </div>
  </div>
</div>
