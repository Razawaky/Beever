<div class="mx-auto w-full max-w-5xl overflow-hidden rounded-favo bg-white shadow-xl">

    <% if (colmeia.conquistas.length > 0) { %>
    <div class="px-8 pt-8">
        <%- include('../partials/ui/conquista-nova', { conquistas: colmeia.conquistas }) %>
    </div>
    <% } %>

    <% if (colmeia.ciclo.aviso || colmeia.ciclo.eventos.length > 0) { %>
    <div class="px-8 pt-8">
        <%- include('../partials/ui/aviso-do-ciclo', {
        avisoDoCiclo: colmeia.ciclo.aviso,
        eventosDoCiclo: colmeia.ciclo.eventos,
        }) %>
    </div>
    <% } %>

    <div class="pb-8">
    <div class="px-8 pt-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-xl">Minha trilha</h2>
        <a href="/painel/trilha" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver trilha inteira &rarr;</a>
        </div>

        <% if (colmeia.trilha.length === 0) { %>
        <div class="mt-4">
            <%- include('../partials/ui/estado-vazio', { mensagem: 'Sua trilha aparece assim que houver conteúdo para a sua idade.',}) %>
        </div>
        <% } else { %>
        <ol class="favo-trilha mt-4 space-y-6">
            <% colmeia.trilha.forEach((favo) => { %>
            <li>
                <div class="<%= favo.emFoco ? 'rounded-favo bg-cera p-4' : 'opacity-80' %>">
                <%- include('../partials/ui/favo-card', { favo, compacto: !favo.emFoco, caminhoBase: '/painel/trilha' }) %>
                </div>
            </li>
            <% }) %>
        </ol>
        <% } %>
    </div>

    <%# Botão pra continuar, quando tela for de celular %>
    <div class="px-8 pt-6">
        <%- include('../partials/ui/botao-continuar', { proximaCelula: colmeia.proximaCelula, fixo: true, caminhoTrilha: '/painel/trilha' }) %>
    </div>
    </div>

</div>