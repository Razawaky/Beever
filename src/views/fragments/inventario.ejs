<%#
  O miolo do inventário (RF-INV-01 a 04). Bens e enfeites ficam em blocos
  separados porque a diferença é a lição: um vira patrimônio, o outro é consumo
  (RN-041). A variação de cada item é a diferença entre o que foi pago e o que
  vale hoje.

  A página `/inventario` e a seção `/painel/inventario` usam este mesmo miolo;
  `comTitulo` evita o título repetido quando a casca já traz um no cabeçalho.
-%>
<%
  const mostrarTitulo = locals.comTitulo !== false;
%>

<% if (mostrarTitulo) { %>
  <h2 class="font-display text-2xl font-bold text-tinta">Meus itens</h2>
<% } %>

<div class="<%= mostrarTitulo ? 'mt-6' : '' %>">
  <%- include('../partials/ui/patrimonio-topo', { patrimonio: resumo.patrimonio, mostrarComposicao: false }) %>
</div>

<section class="mt-10">
  <h2 class="flex items-center gap-2 font-display text-xl">
    Bens
    <span class="dica-info" tabindex="0" aria-describedby="dica-bens">
      <span aria-hidden="true">?</span>
      <span id="dica-bens" role="tooltip" class="dica-info-balao">Itens que contam no seu patrimônio</span>
    </span>
  </h2>

  <% if (resumo.bens.length === 0) { %>
    <p class="mt-4 rounded-favo bg-white p-6 text-sm text-tinta-suave">
      Você ainda não tem nenhum bem. Na loja dá para começar pequeno.
    </p>
  <% } else { %>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      <% resumo.bens.forEach((grupo) => { %>
        <% const variacao = grupo.valorTotal - grupo.valorPago; %>
        <li class="rounded-favo bg-white p-5 shadow-md">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="font-bold"><%= grupo.nome %></h3>
              <p class="text-xs uppercase tracking-wide text-tinta-suave"><%= grupo.categoria %></p>
            </div>
            <span class="rounded-pilula bg-cera px-3 py-1 text-sm">x<%= grupo.quantidade %></span>
          </div>

          <dl class="mt-4 grid gap-1 text-sm tabular-nums">
            <div class="flex justify-between">
              <dt class="text-tinta-suave">Você pagou</dt>
              <dd class="inline-flex items-center gap-1.5"><%- svgIcone('mel', 'h-4 w-4') %><span><%= grupo.valorPago %></span></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-tinta-suave">Vale hoje</dt>
              <dd class="inline-flex items-center gap-1.5 font-semibold"><%- svgIcone('mel', 'h-4 w-4') %><span><%= grupo.valorTotal %></span></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-tinta-suave">Variação</dt>
              <dd class="inline-flex items-center gap-1.5">
                <% if (variacao > 0) { %><%- svgIcone('tendenciaAlta', 'h-4 w-4') %><span>+<%= variacao %></span>
                <% } else if (variacao < 0) { %><%- svgIcone('tendenciaBaixa', 'h-4 w-4') %><span><%= variacao %></span>
                <% } else { %><span><%= variacao %></span><% } %>
              </dd>
            </div>
          </dl>

          <ul class="mt-3 grid gap-1 text-sm tabular-nums">
            <% if (grupo.rendaSemanal > 0) { %>
              <li class="flex items-center gap-2"><%- svgIcone('mel', 'h-4 w-4 shrink-0') %><span>Rende <%= grupo.rendaSemanal * grupo.quantidade %> de mel por semana</span></li>
            <% } %>
            <% if (grupo.custoSemanal > 0) { %>
              <li class="flex items-center gap-2"><%- svgIcone('gasto', 'h-4 w-4 shrink-0') %><span>Custa <%= grupo.custoSemanal * grupo.quantidade %> de mel por semana</span></li>
            <% } %>
          </ul>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="mt-10">
  <h2 class="flex items-center gap-2 font-display text-xl">
    Enfeites
    <span class="dica-info" tabindex="0" aria-describedby="dica-enfeites">
      <span aria-hidden="true">?</span>
      <span id="dica-enfeites" role="tooltip" class="dica-info-balao">Itens para customização do perfil</span>
    </span>
  </h2>

  <% if (resumo.cosmeticos.length === 0) { %>
    <p class="mt-4 rounded-favo bg-white p-6 text-sm text-tinta-suave">Nenhum enfeite por enquanto.</p>
  <% } else { %>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      <% resumo.cosmeticos.forEach((grupo) => { %>
        <li class="rounded-favo bg-white p-5 shadow-md">
          <h3 class="font-bold"><%= grupo.nome %></h3>
          <p class="text-xs uppercase tracking-wide text-tinta-suave"><%= grupo.categoria %></p>
          <p class="mt-3 text-sm">x<%= grupo.quantidade %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
