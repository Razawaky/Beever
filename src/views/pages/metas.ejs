<!doctype html>
<html lang="pt-BR">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-cera text-tinta antialiased">
    <header class="bg-mel px-6 py-6">
      <div class="mx-auto flex max-w-3xl items-center justify-between">
        <a href="/painel" class="font-semibold text-tinta hover:underline">&larr; Painel</a>
        <h1 class="text-2xl font-bold">Minhas metas</h1>
        <span></span>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-10">
      <section class="mb-10 rounded-favo bg-white p-6 shadow-md">
        <h2 class="mb-4 text-lg font-semibold">Nova meta</h2>
        <form method="POST" action="/metas" class="grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input
            type="text"
            name="titulo"
            required
            maxlength="255"
            placeholder="Título da meta"
            class="rounded-lg border border-linha px-4 py-2 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta sm:col-span-2"
          />
          <input
            type="text"
            name="descricao"
            required
            maxlength="500"
            placeholder="Descrição"
            class="rounded-lg border border-linha px-4 py-2 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta sm:col-span-2"
          />
          <div>
            <label class="mb-1 block text-xs text-tinta-suave">Prazo final</label>
            <input
              type="date"
              name="data_final"
              required
              class="w-full rounded-lg border border-linha px-4 py-2 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
            />
          </div>
          <button
            type="submit"
            class="self-end rounded-favo bg-mel px-4 py-2 text-sm font-semibold text-tinta transition hover:-translate-y-0.5 hover:bg-nectar active:translate-y-0 active:bg-ambar focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2 focus-visible:ring-2 focus-visible:ring-tinta"
          >
            Criar meta
          </button>
        </form>
      </section>

      <% if (metas.length === 0) { %>
        <p class="text-tinta-suave">Nenhuma meta ainda. Crie a primeira acima.</p>
      <% } %>

      <div class="space-y-6">
        <% metas.forEach((meta) => { %>
          <section class="rounded-favo bg-white p-6 shadow-md">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-lg font-bold"><%= meta.titulo %></h3>
                <p class="mt-1 text-sm text-tinta-suave"><%= meta.descricao %></p>
                <p class="mt-1 text-xs text-tinta-suave">
                  Prazo: <%= new Date(meta.data_final).toLocaleDateString('pt-BR') %>
                </p>
              </div>
              <div class="w-24 text-right">
                <span class="text-sm font-semibold"><%= meta.progresso %>%</span>
                <div class="mt-1 h-2 overflow-hidden rounded-pilula bg-linha">
                  <div class="h-full bg-mel" style="width: <%= meta.progresso %>%"></div>
                </div>
              </div>
            </div>

            <ul class="mt-5 space-y-2">
              <% meta.tarefas.forEach((tarefa) => { %>
                <li class="flex items-center justify-between rounded-lg bg-cera px-4 py-3 text-sm">
                  <div>
                    <span class="<%= tarefa.progresso >= 100 ? 'line-through text-tinta-suave' : '' %> font-medium">
                      <%= tarefa.titulo %>
                    </span>
                    <span class="ml-2 text-xs text-tinta-suave">
                      <%= tarefa.prioridade %> · prazo <%= new Date(tarefa.data_prazo).toLocaleDateString('pt-BR') %>
                    </span>
                  </div>
                  <% if (tarefa.progresso >= 100) { %>
                    <span class="text-xs font-semibold text-acerto-texto">Concluída ✓</span>
                  <% } else { %>
                    <form method="POST" action="/tarefas/<%= tarefa.id %>/concluir">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button
                        type="submit"
                        class="rounded-favo bg-mel px-3 py-1.5 text-xs font-semibold text-tinta transition hover:-translate-y-0.5 hover:bg-nectar active:translate-y-0 active:bg-ambar focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2 focus-visible:ring-2 focus-visible:ring-tinta"
                      >
                        Concluir
                      </button>
                    </form>
                  <% } %>
                </li>
              <% }) %>
            </ul>

            <details class="mt-4">
              <summary class="cursor-pointer text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4">
                Adicionar tarefa
              </summary>
              <form method="POST" action="/metas/<%= meta.id %>/tarefas" class="mt-3 grid gap-2 sm:grid-cols-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input
                  type="text"
                  name="titulo"
                  required
                  maxlength="255"
                  placeholder="Título da tarefa"
                  class="rounded-lg border border-linha px-3 py-2 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta sm:col-span-2"
                />
                <input
                  type="text"
                  name="descricao"
                  required
                  maxlength="500"
                  placeholder="Descrição"
                  class="rounded-lg border border-linha px-3 py-2 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta sm:col-span-2"
                />
                <input
                  type="date"
                  name="data_prazo"
                  required
                  class="rounded-lg border border-linha px-3 py-2 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
                />
                <select
                  name="prioridade"
                  class="rounded-lg border border-linha px-3 py-2 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
                >
                  <option value="Baixa">Baixa</option>
                  <option value="Media" selected>Média</option>
                  <option value="Alta">Alta</option>
                </select>
                <button
                  type="submit"
                  class="rounded-favo bg-mel px-3 py-2 text-sm font-semibold text-tinta transition hover:-translate-y-0.5 hover:bg-nectar active:translate-y-0 active:bg-ambar focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2 focus-visible:ring-2 focus-visible:ring-tinta sm:col-span-2"
                >
                  Adicionar tarefa
                </button>
              </form>
            </details>
          </section>
        <% }) %>
      </div>
    </main>
  </body>
</html>
