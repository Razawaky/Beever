  <div class="flex min-h-screen flex-col md:flex-row">
    <div class="relative hidden flex-1 flex-col items-center justify-center bg-mel p-8 md:flex">
      <%- include('../partials/ui/mascote', { pose: 'entrando', decorativa: true, classe: 'h-auto w-3/4 max-w-md' }) %>
      <img
        src="/img/beever_logo_black.webp"
        alt="Beever"
        width="1028"
        height="326"
        class="absolute bottom-12 h-8 w-auto"
      />
    </div>

    <div class="flex flex-1 items-center justify-center p-8">
      <div class="w-full max-w-sm">
        <a href="/login" class="text-sm text-tinta-suave hover:text-tinta">&larr; Voltar para entrar</a>

        <h1 class="mt-6 text-3xl font-bold">Esqueceu a senha?</h1>

        <% if (enviado) { %>
          <%# A mesma frase aparece exista a conta ou não: dizer "não achamos" revelaria quem tem conta. %>
          <p role="status" class="mt-6 rounded-favo border border-linha bg-cera p-4 text-sm">
            Se existir uma conta com esse e-mail, mandamos um link para trocar a senha.
            Olhe a caixa de entrada e também o spam. O link vale por <%= validadeEmMinutos %> minutos.
          </p>
          <p class="mt-6 text-center text-sm text-tinta-suave">
            Não chegou?
            <a href="/recuperar-senha" class="font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Pedir de novo</a>
          </p>
        <% } else { %>
          <p class="mt-2 text-tinta-suave">Digite o e-mail da conta. Vamos mandar um link para você escolher uma senha nova.</p>

          <form method="POST" action="/sessao/recuperar-senha" class="mt-8 space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div>
              <label for="email" class="mb-1 block text-sm font-medium">E-mail</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="nome@exemplo.com"
                class="w-full rounded-lg border border-linha px-4 py-3 text-sm focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
              />
            </div>

            <%- include('../partials/ui/botao', { texto: 'Mandar link', tipo: 'submit', classe: 'w-full' }) %>
          </form>
        <% } %>
      </div>
    </div>
  </div>
