<%#
  A loja (RF-LOJ-01 a 07). Tudo já vem respondido pelo `shopService`: preço com
  desconto de troca, o que falta para desbloquear e o que o item cobra nesta
  faixa. A tela agrupa por categoria e desenha.
%>
<header class="bg-mel px-6 py-6">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4">
    <a href="/painel" class="font-semibold text-tinta hover:underline">&larr; Painel</a>
    <h1 class="text-2xl font-bold">Loja</h1>
    <a href="/inventario" class="font-semibold text-tinta hover:underline">Meus itens &rarr;</a>
  </div>
</header>

<main class="mx-auto max-w-5xl px-6 py-10">
  <%- include('../partials/ui/patrimonio-topo', { patrimonio: vitrine.patrimonio }) %>

  <% if (vitrine.itens.length === 0) { %>
    <p class="mt-10 text-tinta-suave">Nenhum item disponível no momento.</p>
  <% } %>

  <%
    // Agrupamento por categoria (RF-LOJ-02). É ordem de exibição, não regra:
    // por isso mora aqui, e não no service.
    const porCategoria = new Map();
    vitrine.itens.forEach((item) => {
      const lista = porCategoria.get(item.category_name) ?? [];
      lista.push(item);
      porCategoria.set(item.category_name, lista);
    });
  %>

  <% for (const [categoria, itens] of porCategoria) { %>
    <section class="mt-10">
      <h2 class="font-display text-xl"><%= categoria %></h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% itens.forEach((item) => { %>
          <%- include('../partials/ui/item-card', { item }) %>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>
