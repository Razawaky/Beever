<%#
  Catálogo de conquistas no painel. Mostra a desativada junto, porque é daqui que
  o administrador reativa — a tela do jogador é que esconde a inativa.
-%>
<%- include('../../partials/admin/casca', { emailDoAdmin, atual: 'conquistas' }) %>

<%
  const nomeDoCriterio = (slug) => criterios.find((criterio) => criterio.slug === slug)?.nome ?? slug;
%>

<main class="mx-auto max-w-5xl px-6 py-10">
  <div class="flex flex-wrap items-center gap-4">
    <h1 class="text-3xl font-bold">Conquistas</h1>
    <%- include('../../partials/ui/botao', { texto: 'Nova conquista', href: '/admin/conquistas/novo', tamanho: 'medio', classe: 'ml-auto' }) %>
  </div>
  <p class="mt-2 text-tinta-suave">
    O que destrava automaticamente quando o jogador alcança o alvo. O bônus é creditado no servidor.
  </p>

  <div class="mt-8 overflow-x-auto rounded-favo border border-linha bg-white">
    <table class="w-full text-left text-sm">
      <caption class="sr-only">Conquistas do catálogo</caption>
      <thead class="border-b border-linha text-tinta-suave">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">Conquista</th>
          <th scope="col" class="px-4 py-3 font-semibold">Critério</th>
          <th scope="col" class="px-4 py-3 font-semibold">Alvo</th>
          <th scope="col" class="px-4 py-3 font-semibold">Bônus</th>
          <th scope="col" class="px-4 py-3 font-semibold">Situação</th>
          <th scope="col" class="px-4 py-3 font-semibold">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% conquistas.forEach((conquista) => { %>
          <tr class="border-b border-linha last:border-0">
            <td class="px-4 py-3">
              <div class="font-medium"><%= conquista.name %></div>
              <div class="text-xs text-tinta-suave"><%= conquista.slug %></div>
            </td>
            <td class="px-4 py-3"><%= nomeDoCriterio(conquista.criterion_type) %></td>
            <td class="px-4 py-3"><%= conquista.criterion_target %></td>
            <td class="px-4 py-3"><%= conquista.reward_coins %> de mel</td>
            <td class="px-4 py-3"><%= conquista.is_active ? 'Ativa' : 'Desativada' %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap items-center gap-2">
                <a href="/admin/conquistas/<%= conquista.id %>/editar" class="inline-flex min-h-11 items-center underline underline-offset-4">Editar</a>
                <form method="POST" action="/admin/conquistas/<%= conquista.id %>/ativo">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="ativo" value="<%= conquista.is_active ? 'false' : 'true' %>" />
                  <%- include('../../partials/ui/botao', {
                    texto: conquista.is_active ? 'Desativar' : 'Reativar',
                    tipo: 'submit',
                    variante: 'secundario',
                    tamanho: 'medio',
                    formato: 'pilula',
                  }) %>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>
