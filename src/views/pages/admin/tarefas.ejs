<%#
  Catálogo de tipos de tarefa no painel. Mostra o desativado junto, porque é daqui
  que o administrador reativa — a agenda do jogador é que esconde o inativo.
-%>
<%- include('../../partials/admin/casca', { emailDoAdmin, atual: 'tarefas' }) %>

<%
  const nomeDoEscopo = (slug) => escopos.find((escopo) => escopo.slug === slug)?.nome ?? slug;
  const nomeDaFonte = (slug) => fontes.find((fonte) => fonte.slug === slug)?.nome ?? slug;
%>

<main class="mx-auto max-w-5xl px-6 py-10">
  <div class="flex flex-wrap items-center gap-4">
    <h1 class="text-3xl font-bold">Tarefas</h1>
    <%- include('../../partials/ui/botao', { texto: 'Nova tarefa', href: '/admin/tarefas/novo', tamanho: 'medio', classe: 'ml-auto' }) %>
  </div>
  <p class="mt-2 text-tinta-suave">
    Compromissos curtos que o gerador distribui por dia. Alvo e recompensa são copiados para a
    tarefa quando ela nasce; o mel e o pólen são creditados no servidor.
  </p>

  <div class="mt-8 overflow-x-auto rounded-favo border border-linha bg-white">
    <table class="w-full text-left text-sm">
      <caption class="sr-only">Tipos de tarefa do catálogo</caption>
      <thead class="border-b border-linha text-tinta-suave">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">Tarefa</th>
          <th scope="col" class="px-4 py-3 font-semibold">Escopo</th>
          <th scope="col" class="px-4 py-3 font-semibold">Fonte</th>
          <th scope="col" class="px-4 py-3 font-semibold">Alvo</th>
          <th scope="col" class="px-4 py-3 font-semibold">Recompensa</th>
          <th scope="col" class="px-4 py-3 font-semibold">Situação</th>
          <th scope="col" class="px-4 py-3 font-semibold">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% tarefas.forEach((tarefa) => { %>
          <tr class="border-b border-linha last:border-0">
            <td class="px-4 py-3">
              <div class="font-medium"><%= tarefa.name %></div>
              <div class="text-xs text-tinta-suave"><%= tarefa.slug %></div>
            </td>
            <td class="px-4 py-3"><%= nomeDoEscopo(tarefa.scope) %></td>
            <td class="px-4 py-3"><%= nomeDaFonte(tarefa.progress_source) %></td>
            <td class="px-4 py-3"><%= tarefa.default_target %></td>
            <td class="px-4 py-3"><%= tarefa.reward_coins %> de mel · <%= tarefa.reward_points %> de pólen</td>
            <td class="px-4 py-3"><%= tarefa.is_active ? 'Ativa' : 'Desativada' %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap items-center gap-2">
                <a href="/admin/tarefas/<%= tarefa.id %>/editar" class="inline-flex min-h-11 items-center underline underline-offset-4">Editar</a>
                <form method="POST" action="/admin/tarefas/<%= tarefa.id %>/ativo">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="ativo" value="<%= tarefa.is_active ? 'false' : 'true' %>" />
                  <%- include('../../partials/ui/botao', {
                    texto: tarefa.is_active ? 'Desativar' : 'Reativar',
                    tipo: 'submit',
                    variante: 'secundario',
                    tamanho: 'medio',
                    formato: 'pilula',
                  }) %>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>
