<%#
  Login administrativo (RF-ADM-01). Porta separada da do jogador, com a mesma
  senha e a mesma sessão — o que muda é a exigência de ser admin, conferida no
  service. Sem mascote e sem cor de jogo: esta tela não é para criança.
-%>
<main class="flex min-h-screen items-center justify-center p-8">
  <div class="w-full max-w-sm">
    <a href="/" class="text-sm text-tinta-suave hover:text-tinta">&larr; Voltar ao site</a>

    <h1 class="mt-6 text-3xl font-bold">Administração</h1>
    <p class="mt-2 text-tinta-suave">Entre com uma conta de administrador.</p>

    <% if (locals.erro) { %>
      <%- include('../../partials/ui/aviso-de-erro') %>
    <% } %>

    <form method="POST" action="/admin/login" class="mt-8 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div>
        <label for="email" class="mb-1 block text-sm font-medium">E-mail</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          value="<%= locals.email || '' %>"
          aria-invalid="<%= Boolean(locals.erroDeEmail) %>"
          <% if (locals.mensagemEmail) { %>aria-describedby="email-erro"<% } %>
          class="w-full rounded-lg border <%= locals.erroDeEmail ? 'border-erro focus:border-erro' : 'border-linha focus:border-mel' %> px-4 py-3 text-sm focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
        />
        <% if (locals.mensagemEmail) { %>
          <p id="email-erro" class="mt-1 text-xs font-medium text-erro-texto"><%= mensagemEmail %></p>
        <% } %>
      </div>

      <div>
        <label for="senha" class="mb-1 block text-sm font-medium">Senha</label>
        <input
          id="senha"
          name="senha"
          type="password"
          required
          autocomplete="current-password"
          aria-invalid="<%= Boolean(locals.erroDeSenha) %>"
          <% if (locals.mensagemSenha) { %>aria-describedby="senha-erro"<% } %>
          class="w-full rounded-lg border <%= locals.erroDeSenha ? 'border-erro focus:border-erro' : 'border-linha focus:border-mel' %> px-4 py-3 text-sm focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
        />
        <% if (locals.mensagemSenha) { %>
          <p id="senha-erro" class="mt-1 text-xs font-medium text-erro-texto"><%= mensagemSenha %></p>
        <% } %>
      </div>

      <%- include('../../partials/ui/botao', { texto: 'Entrar', tipo: 'submit', classe: 'w-full' }) %>
    </form>
  </div>
</main>
