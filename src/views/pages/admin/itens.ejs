<%#
  Catálogo da loja no painel. Mostra o desativado junto, porque é daqui que o
  administrador reativa — a vitrine do jogador é que esconde o inativo.
-%>
<%- include('../../partials/admin/casca', { emailDoAdmin, atual: 'itens' }) %>

<main class="mx-auto max-w-5xl px-6 py-10">
  <div class="flex flex-wrap items-center gap-4">
    <h1 class="text-3xl font-bold">Itens</h1>
    <%- include('../../partials/ui/botao', { texto: 'Novo item', href: '/admin/itens/novo', tamanho: 'medio', classe: 'ml-auto' }) %>
  </div>
  <p class="mt-2 text-tinta-suave">O que a criança pode comprar com o mel que ganhou.</p>

  <div class="mt-8 overflow-x-auto rounded-favo border border-linha bg-white">
    <table class="w-full text-left text-sm">
      <caption class="sr-only">Itens do catálogo</caption>
      <thead class="border-b border-linha text-tinta-suave">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">Arte</th>
          <th scope="col" class="px-4 py-3 font-semibold">Nome</th>
          <th scope="col" class="px-4 py-3 font-semibold">Categoria</th>
          <th scope="col" class="px-4 py-3 font-semibold">Preço</th>
          <th scope="col" class="px-4 py-3 font-semibold">Compras</th>
          <th scope="col" class="px-4 py-3 font-semibold">Situação</th>
          <th scope="col" class="px-4 py-3 font-semibold">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% itens.forEach((item) => { %>
          <tr class="border-b border-linha last:border-0">
            <td class="px-4 py-3">
              <% if (item.image_path) { %>
                <img src="<%= item.image_path %>" alt="" width="48" height="48" class="h-12 w-12 rounded object-cover" />
              <% } else { %>
                <span class="text-xs text-tinta-suave">sem arte</span>
              <% } %>
            </td>
            <td class="px-4 py-3 font-medium"><%= item.name %></td>
            <td class="px-4 py-3"><%= item.category_name %></td>
            <td class="px-4 py-3"><%= item.price %> de mel</td>
            <td class="px-4 py-3"><%= item.compras %></td>
            <td class="px-4 py-3"><%= item.is_active ? 'Ativo' : 'Desativado' %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap items-center gap-2">
                <a href="/admin/itens/<%= item.id %>/editar" class="inline-flex min-h-11 items-center underline underline-offset-4">Editar</a>
                <form method="POST" action="/admin/itens/<%= item.id %>/ativo">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="ativo" value="<%= item.is_active ? 'false' : 'true' %>" />
                  <%- include('../../partials/ui/botao', {
                    texto: item.is_active ? 'Desativar' : 'Reativar',
                    tipo: 'submit',
                    variante: 'secundario',
                    tamanho: 'medio',
                    formato: 'pilula',
                  }) %>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>
