<%#
  Conteúdo da atividade em JSON. Salvar não sobrescreve: grava uma versão nova e
  desativa a anterior, que continua na tabela explicando as partidas já jogadas.
  O formulário campo a campo por tipo de jogo é a T-12.4.
-%>
<%- include('../../partials/admin/casca', { emailDoAdmin, atual: 'conteudo' }) %>

<main class="mx-auto max-w-3xl px-6 py-10">
  <a href="/admin/favos/<%= celula.hive_id %>" class="text-sm text-tinta-suave hover:text-tinta">
    &larr; Voltar às células
  </a>

  <h1 class="mt-4 text-3xl font-bold">Conteúdo de <%= celula.title %></h1>
  <p class="mt-2 text-tinta-suave">
    Tipo de jogo: <strong><%= celula.game_type_name %></strong> ·
    <%= atual ? `versão ${atual.version} no ar` : 'nenhuma versão publicada' %>
  </p>

  <form method="POST" action="/admin/celulas/<%= celula.id %>/conteudo" class="mt-8 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div>
      <label for="corpo" class="mb-1 block text-sm font-medium">Conteúdo em JSON</label>
      <textarea
        id="corpo"
        name="corpo"
        rows="18"
        required
        spellcheck="false"
        class="w-full rounded-lg border border-linha px-4 py-3 font-mono text-xs focus:border-mel focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
      ><%= atual ? JSON.stringify(atual.body, null, 2) : '' %></textarea>
      <p class="mt-1 text-xs text-tinta-suave">
        O validador do tipo de jogo confere o formato antes de publicar. Conteúdo torto é recusado
        aqui, e não na tela da criança.
      </p>
    </div>

    <%- include('../../partials/ui/botao', { texto: 'Publicar versão nova', tipo: 'submit' }) %>
  </form>

  <% if (versoes.length > 0) { %>
    <section class="mt-10">
      <h2 class="text-lg font-semibold">Versões</h2>
      <ul class="mt-3 space-y-1 text-sm text-tinta-suave">
        <% versoes.forEach((versao) => { %>
          <li>
            Versão <%= versao.version %> — publicada em
            <%= new Date(versao.created_at).toLocaleDateString('pt-BR') %>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>
</main>
