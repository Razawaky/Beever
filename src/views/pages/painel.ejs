<%#
  A Colmeia (RF-HOM). Tudo o que a tela mostra vem pronto de `colmeia`. O topo
  é partial e fica fora do cartão branco de propósito: `overflow-hidden` no
  ancestral desliga o `sticky` do cabeçalho.

  A partir de `lg` a tela vira duas colunas: a trilha e o "Continuar" de um
  lado, as tarefas e a meta do outro. A ordem do HTML é a do celular, então
  empilhar continua dando trilha, continuar, tarefas e meta.
%>

<div class="min-h-screen bg-fundo lg:flex">
  <%- include('../partials/ui/sidebar-colmeia', {
    jogador: colmeia.jogador,
    sequencia: colmeia.sequencia,
  }) %>
  
  <%# Conteúdo principal %>
  <main class="flex-1 p-4 lg:p-8">

    <div class="fixed top-4 left-1/2 z-[100] -translate-x-1/2 pointer-events-none lg:left-[calc(50%+8rem)]">
      <div class="pointer-events-auto w-fit rounded-full border border-tinta/10 bg-white/95 px-6 py-2.5 shadow-xl backdrop-blur transition-all">
        <%- include('../partials/ui/chama-sequencia', { sequencia: colmeia.sequencia, href: '/metas' }) %>
      </div>
    </div>

    <div class="mx-auto max-w-5xl overflow-hidden rounded-favo bg-white shadow-xl lg:max-w-7xl">

      <% if (colmeia.conquistas.length > 0) { %>
        <div class="px-8 pt-8">
          <%- include('../partials/ui/conquista-nova', { conquistas: colmeia.conquistas }) %>
        </div>
      <% } %>

      <% if (colmeia.ciclo.aviso || colmeia.ciclo.eventos.length > 0) { %>
        <div class="px-8 pt-8">
          <%- include('../partials/ui/aviso-do-ciclo', {
            avisoDoCiclo: colmeia.ciclo.aviso,
            eventosDoCiclo: colmeia.ciclo.eventos,
          }) %>
        </div>
      <% } %>

      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start">
        <div>
          <div class="px-8 pt-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="font-display text-xl">Minha trilha</h2>
              <a href="/trilha" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver trilha inteira &rarr;</a>
            </div>

            <% if (colmeia.trilha.length === 0) { %>
              <div class="mt-4">
                <%- include('../partials/ui/estado-vazio', { mensagem: 'Sua trilha aparece assim que houver conteúdo para a sua idade.',}) %>
              </div>
            <% } else { %>
              <ol class="favo-trilha mt-4 space-y-6">
                <% colmeia.trilha.forEach((favo) => { %>
                  <li>
                    <div class="<%= favo.emFoco ? 'rounded-favo bg-cera p-4' : 'opacity-80' %>">
                      <%- include('../partials/ui/favo-card', { favo, compacto: !favo.emFoco }) %>
                    </div>
                  </li>
                <% }) %>
              </ol>
            <% } %>
          </div>

          <%# Botão pra continuar, quando tela for de celular %>
          <div class="px-8 pt-6">
            <%- include('../partials/ui/botao-continuar', { proximaCelula: colmeia.proximaCelula, fixo: true }) %>
          </div>
        </div>
        
      </div>

      <%# INVENTÁRIO %>
      <div class="grid gap-6 p-8 lg:grid-cols-2">
        <section class="rounded-favo bg-cera p-6">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold">Seus itens</h2>
            <a href="/inventario" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver meus itens &rarr;</a>
          </div>
          <div class="rounded-lg bg-white p-4">
            <p class="text-sm text-tinta-suave">Patrimônio é tudo o que você tem somado: o mel na carteira, o mel guardado no cofre e o valor dos seus bens.</p>

            <dl class="mt-3 grid gap-x-8 gap-y-1 text-sm tabular-nums sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
              <div class="flex justify-between gap-2">
                <dt class="text-tinta-suave">Na carteira</dt>
                <dd><%= colmeia.jogador.patrimonio.carteira %></dd>
              </div>
              <div class="flex justify-between gap-2">
                <dt class="text-tinta-suave">No cofre</dt>
                <dd><%= colmeia.jogador.patrimonio.cofre %></dd>
              </div>
              <div class="flex justify-between gap-2">
                <dt class="text-tinta-suave">Em bens</dt>
                <dd><%= colmeia.jogador.patrimonio.bens %></dd>
              </div>
            </dl>
          </div>
        </section>

        <%# LIGA %>
        <section class="rounded-favo bg-cera p-6">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold">Sua liga da semana</h2>
            <a href="/liga" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver a liga &rarr;</a>
          </div>

          <% if (!colmeia.liga || colmeia.liga.posicao === null) { %>
            <p class="text-sm text-tinta-suave">Ganhe seu primeiro pólen da semana e você entra no ranque do seu grupo.</p>
          <% } else { %>
            <p class="text-sm tabular-nums">
              Você está em <strong><%= colmeia.liga.posicao %>º lugar</strong> no <%= colmeia.liga.grupo.nome %>,
              com 🌼 <%= colmeia.liga.polen %> de pólen. Ninguém desce de liga.
            </p>
          <% } %>
        </section>
      </div>

      <%# LOJA %>
      <div class="grid gap-4 px-8 pb-8 sm:grid-cols-2 lg:grid-cols-3">
        <a
          href="/loja"
          class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
        >
          🛒 Ir para a loja
        </a>
        <a
          href="/cofre"
          class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
        >
          🏦 Meu cofre
        </a>
        <a
          href="/conquistas"
          class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
        >
          🏆 Minhas conquistas
        </a>
        <% if (mostrarAtalhoAdmin) { %>
          <a
            href="/admin"
            class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
          >
            ⚙️ Área administrativa
          </a>
        <% } %>
      </div>

      <div class="border-t border-linha px-8 py-6">
        <form method="POST" action="/sessao/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <%# `inline-flex` para a altura de 44 px valer sem esticar a linha inteira. -%>
          <button type="submit" class="inline-flex min-h-11 items-center text-sm font-medium text-tinta-suave hover:text-tinta">
            Sair da conta
          </button>
        </form>
      </div>
    </div>
  </main>
</div>