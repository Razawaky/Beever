<%#
  A Colmeia (RF-HOM). Tudo o que a tela mostra vem pronto de `colmeia`: nível,
  saldo, patrimônio, sequência, meta em destaque e o aviso do ciclo. As telas
  próprias de cada bloco entram nas tarefas seguintes da E10.
%>
<div class="mx-auto max-w-5xl overflow-hidden rounded-favo bg-white shadow-xl">
    <div class="flex flex-col gap-6 bg-mel px-8 py-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <div class="flex h-16 w-16 items-center justify-center rounded-pilula bg-white/40 text-2xl font-bold">
          <%= colmeia.jogador.apelido.charAt(0).toUpperCase() %>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-tinta sm:text-3xl"><%= colmeia.jogador.apelido %></h1>
          <p class="text-sm text-tinta-suave">Nível <%= colmeia.jogador.nivel?.nivel ?? 1 %></p>
        </div>
      </div>

      <%# A sequência fica no topo do painel, e não escondida em /metas: é o
          gancho diário, e escondê-la atrás de um clique some com ela. %>
      <a href="/metas" class="rounded-favo px-2 py-1 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2">
        <p class="text-sm font-semibold text-tinta">
          🔥 <%= colmeia.sequencia.diasAtuais %> <%= colmeia.sequencia.diasAtuais === 1 ? 'dia seguido' : 'dias seguidos' %>
        </p>
        <div class="mt-2">
          <%- include('../partials/ui/calendario-semana', { semana: colmeia.sequencia, compacto: true }) %>
        </div>
      </a>

      <div class="text-left sm:text-right">
        <p class="text-lg font-semibold tabular-nums">🍯 <%= colmeia.jogador.mel %> de mel</p>
        <p class="text-sm tabular-nums text-tinta-suave">🌼 <%= colmeia.jogador.polen %> de pólen</p>
        <%# O progresso dentro do nível vem calculado do service: a curva mora
            em `levels` e a conta não se repete na view. %>
        <% const progressoNivel = colmeia.jogador.nivel?.progressoPercentual ?? 0; %>
        <div
          class="mt-2 h-3 w-56 overflow-hidden rounded-pilula bg-white/40"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="<%= progressoNivel %>"
          aria-label="Progresso até o próximo nível"
        >
          <div class="h-full rounded-pilula bg-breu <%= classeDaBarra(progressoNivel) %>"></div>
        </div>
        <p class="mt-1 text-xs text-tinta-suave">
          <% if (colmeia.jogador.nivel?.noTopo) { %>
            Nível máximo alcançado
          <% } else { %>
            faltam <%= colmeia.jogador.nivel?.xpParaSubir ?? 0 %> XP para o nível <%= (colmeia.jogador.nivel?.nivel ?? 1) + 1 %>
          <% } %>
        </p>
      </div>
    </div>

    <%# O que a economia fez enquanto o jogador estava fora vem antes da trilha:
        é notícia, e notícia velha não é notícia. %>
    <% if (colmeia.ciclo.aviso || colmeia.ciclo.eventos.length > 0) { %>
      <div class="px-8 pt-8">
        <%- include('../partials/ui/aviso-do-ciclo', {
          avisoDoCiclo: colmeia.ciclo.aviso,
          eventosDoCiclo: colmeia.ciclo.eventos,
        }) %>
      </div>
    <% } %>

    <%# A trilha é o que o jogador vem fazer: primeiro card, largura inteira. %>
    <div class="px-8 pt-8">
      <a
        href="/trilha"
        class="flex items-center justify-between gap-4 rounded-favo bg-cera p-6 transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        <div>
          <h2 class="font-display text-xl">Minha trilha</h2>
          <p class="mt-1 text-sm text-tinta-suave">Continue de onde você parou nos favos.</p>
        </div>
        <img src="/img/beenie_vem.png" alt="" class="h-16 w-auto" />
      </a>
    </div>

    <div class="grid gap-8 p-8 sm:grid-cols-2">
      <section class="rounded-favo bg-cera p-6">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Seu patrimônio</h2>
          <a href="/inventario" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver meus itens &rarr;</a>
        </div>
        <div class="rounded-lg bg-white p-4">
          <p class="text-2xl font-bold tabular-nums">🍯 <%= colmeia.jogador.patrimonio.total %></p>
          <dl class="mt-3 grid gap-1 text-sm tabular-nums">
            <div class="flex justify-between">
              <dt class="text-tinta-suave">Na carteira</dt>
              <dd><%= colmeia.jogador.patrimonio.carteira %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-tinta-suave">No cofre</dt>
              <dd><%= colmeia.jogador.patrimonio.cofre %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-tinta-suave">Em bens</dt>
              <dd><%= colmeia.jogador.patrimonio.bens %></dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="rounded-favo bg-cera p-6">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Sua meta</h2>
          <a href="/metas" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver todas &rarr;</a>
        </div>
        <% if (!colmeia.metaEmDestaque) { %>
          <div class="flex h-48 items-center justify-center rounded-lg bg-white text-sm text-tinta-suave">
            Você ainda não criou nenhuma meta.
          </div>
        <% } else { %>
          <%# Percentual, prazo e recompensa vêm prontos do `homeService`: conta
              de meta não mora no EJS. %>
          <div class="rounded-lg bg-white p-4">
            <p class="font-semibold"><%= colmeia.metaEmDestaque.titulo %></p>
            <p class="mt-1 text-sm tabular-nums text-tinta-suave">
              <%= colmeia.metaEmDestaque.atual %> de <%= colmeia.metaEmDestaque.alvo %>
            </p>
            <div
              class="mt-4 h-3 w-full overflow-hidden rounded-pilula bg-linha"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="<%= colmeia.metaEmDestaque.percentual %>"
              aria-label="Progresso da meta"
            >
              <div class="h-3 rounded-pilula bg-mel <%= classeDaBarra(colmeia.metaEmDestaque.percentual) %>"></div>
            </div>
            <p class="mt-1 text-sm tabular-nums text-tinta-suave"><%= colmeia.metaEmDestaque.percentual %>% concluído</p>
            <p class="mt-3 text-sm tabular-nums">
              <% if (colmeia.metaEmDestaque.diasRestantes === null) { %>
                Sem prazo
              <% } else if (colmeia.metaEmDestaque.diasRestantes === 0) { %>
                Termina hoje
              <% } else { %>
                Faltam <%= colmeia.metaEmDestaque.diasRestantes %> <%= colmeia.metaEmDestaque.diasRestantes === 1 ? 'dia' : 'dias' %>
              <% } %>
              · rende 🍯 <%= colmeia.metaEmDestaque.melDaRecompensa %>
            </p>
          </div>
        <% } %>
      </section>
    </div>

    <%# A loja e o cofre são o outro lado do jogo: sem porta no painel, só
        chega lá quem digita o endereço. %>
    <div class="grid gap-4 px-8 pb-8 sm:grid-cols-2">
      <a
        href="/loja"
        class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        🛒 Ir para a loja
      </a>
      <a
        href="/cofre"
        class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        🏦 Meu cofre
      </a>
    </div>

    <div class="border-t border-linha px-8 py-6">
      <form method="POST" action="/sessao/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="text-sm font-medium text-tinta-suave hover:text-tinta">
          Sair da conta
        </button>
      </form>
    </div>
  </div>
