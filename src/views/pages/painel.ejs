<%#
  A Colmeia (RF-HOM). Tudo o que a tela mostra vem pronto de `colmeia`. O topo
  é partial e fica fora do cartão branco de propósito: `overflow-hidden` no
  ancestral desliga o `sticky` do cabeçalho.
%>
<%- include('../partials/ui/cabecalho-colmeia', {
  jogador: colmeia.jogador,
  sequencia: colmeia.sequencia,
}) %>

<div class="mx-auto mt-8 max-w-5xl overflow-hidden rounded-favo bg-white shadow-xl">
    <%# O que a economia fez enquanto o jogador estava fora vem antes da trilha:
        é notícia, e notícia velha não é notícia. %>
    <% if (colmeia.ciclo.aviso || colmeia.ciclo.eventos.length > 0) { %>
      <div class="px-8 pt-8">
        <%- include('../partials/ui/aviso-do-ciclo', {
          avisoDoCiclo: colmeia.ciclo.aviso,
          eventosDoCiclo: colmeia.ciclo.eventos,
        }) %>
      </div>
    <% } %>

    <%# A trilha é o que o jogador vem fazer, então vem inteira: o favo em
        andamento e o seguinte ficam grandes, e os mais avançados aparecem
        pequenos e travados, como régua do que ainda vem. %>
    <div class="px-8 pt-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-xl">Minha trilha</h2>
        <a href="/trilha" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver trilha inteira &rarr;</a>
      </div>

      <% if (colmeia.trilha.length === 0) { %>
        <div class="mt-4">
          <%- include('../partials/ui/estado-vazio', {
            mensagem: 'Sua trilha aparece assim que houver conteúdo para a sua idade.',
          }) %>
        </div>
      <% } else { %>
        <ol class="favo-trilha mt-4 space-y-6">
          <% colmeia.trilha.forEach((favo) => { %>
            <li>
              <div class="<%= favo.emFoco ? 'rounded-favo bg-cera p-4' : 'opacity-80' %>">
                <%- include('../partials/ui/favo-card', { favo, compacto: !favo.emFoco }) %>
              </div>
            </li>
          <% }) %>
        </ol>
      <% } %>
    </div>

    <%# A ação principal da Colmeia. No celular ela fica grudada no rodapé, e o
        corpo reserva a folga para não tapar o fim da página. %>
    <div class="px-8 pt-6">
      <%- include('../partials/ui/botao-continuar', { proximaCelula: colmeia.proximaCelula, fixo: true }) %>
    </div>

    <%# Tarefa é o que a colmeia pede hoje; meta é onde o jogador quer chegar.
        A ordem na tela é a ordem do jogo. %>
    <div class="px-8 pt-8">
      <h2 class="font-display text-xl">Suas tarefas de hoje</h2>

      <% if (colmeia.tarefas.length === 0) { %>
        <p class="mt-2 text-sm text-tinta-suave">Nenhuma tarefa por enquanto. A colmeia propõe as do dia quando você entra.</p>
      <% } else { %>
        <ul class="mt-3 grid gap-2">
          <% colmeia.tarefas.forEach((tarefa) => { %>
            <%- include('../partials/ui/card-tarefa', { tarefa, compacto: true, voltarPara: '/painel' }) %>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <%# A meta que vence primeiro é o segundo assunto da Colmeia, em largura
        inteira: dividir a linha com o patrimônio deixava as duas pequenas. %>
    <div class="px-8 pt-8">
      <h2 class="mb-3 font-display text-xl">Sua meta mais próxima</h2>

      <% if (!colmeia.metaEmDestaque) { %>
        <%- include('../partials/ui/estado-vazio', {
          mensagem: 'Suas metas aparecem assim que a colmeia montar seu plano.',
          acao: { href: '/metas', texto: 'Ver metas e tarefas' },
        }) %>
      <% } else { %>
        <%- include('../partials/ui/card-meta', { meta: colmeia.metaEmDestaque, destaque: true }) %>

        <% if (colmeia.outrasMetas.length > 0) { %>
          <%# As outras vêm em uma linha cada, sem barra: com barra elas
              competem com o destaque, e o destaque deixa de ser destaque. %>
          <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-tinta-suave">Suas outras metas</h3>
          <ul class="mt-2 grid gap-2">
            <% colmeia.outrasMetas.forEach((meta) => { %>
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-favo bg-cera px-4 py-3 text-sm">
                <span class="font-medium"><%= meta.titulo %></span>
                <span class="tabular-nums text-tinta-suave">
                  <%= meta.percentual %>% · <%= meta.urgencia.icone %> <%= meta.urgencia.frase %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <p class="mt-4 text-right">
          <a href="/metas" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver todas as metas &rarr;</a>
        </p>
      <% } %>
    </div>

    <div class="p-8">
      <section class="rounded-favo bg-cera p-6">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Seus itens</h2>
          <a href="/inventario" class="text-sm font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver meus itens &rarr;</a>
        </div>
        <div class="rounded-lg bg-white p-4">
          <p class="text-sm text-tinta-suave">Patrimônio é tudo o que você tem somado: o mel na carteira, o mel guardado no cofre e o valor dos seus bens.</p>
          <dl class="mt-3 grid gap-1 text-sm tabular-nums sm:grid-cols-3">
            <div class="flex justify-between gap-2">
              <dt class="text-tinta-suave">Na carteira</dt>
              <dd><%= colmeia.jogador.patrimonio.carteira %></dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-tinta-suave">No cofre</dt>
              <dd><%= colmeia.jogador.patrimonio.cofre %></dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-tinta-suave">Em bens</dt>
              <dd><%= colmeia.jogador.patrimonio.bens %></dd>
            </div>
          </dl>
        </div>
      </section>
    </div>

    <%# A loja e o cofre são o outro lado do jogo: sem porta no painel, só
        chega lá quem digita o endereço. %>
    <div class="grid gap-4 px-8 pb-8 sm:grid-cols-2">
      <a
        href="/loja"
        class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        🛒 Ir para a loja
      </a>
      <a
        href="/cofre"
        class="rounded-favo bg-cera p-5 font-semibold transition hover:bg-mel/20 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        🏦 Meu cofre
      </a>
    </div>

    <div class="border-t border-linha px-8 py-6">
      <form method="POST" action="/sessao/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="text-sm font-medium text-tinta-suave hover:text-tinta">
          Sair da conta
        </button>
      </form>
    </div>
  </div>
