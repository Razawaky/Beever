<%#
  A Colmeia (RF-HOM). Tudo o que a tela mostra vem pronto de `colmeia`. O topo
  é partial e fica fora do cartão branco de propósito: `overflow-hidden` no
  ancestral desliga o `sticky` do cabeçalho.

  A partir de `lg` a tela vira duas colunas: a trilha e o "Continuar" de um
  lado, as tarefas e a meta do outro. A ordem do HTML é a do celular, então
  empilhar continua dando trilha, continuar, tarefas e meta.
%>

<div class="min-h-screen bg-fundo lg:flex lg:pl-72 lg:pr-72">

  <%- include('../partials/ui/sidebar-colmeia', {
    jogador: colmeia.jogador,
  }) %>
  
  <%# Conteúdo principal %>
  <main id="conteudo-main" class="flex-1 p-4 lg:p-8 relative">

    <%- include('../fragments/painel-trilha', { 
      colmeia 
    }) %>

      
    <div class="absolute right-4 bottom-4 z-20">
      <button
        type="button"
        id="beenie-clicavel"
        aria-label="Brincar com a Beenie"
        data-beenie-imagens="<%= posesDoClique.map((pose) => mascote(pose).arquivo).join('|') %>"
        class="cursor-pointer rounded-3xl p-2 transition-transform duration-150 active:scale-95"
      >
        <%- include('../partials/ui/mascote', {
          id: 'beenie-imagem',
          pose: 'clicavel',
          decorativa: true,
          classe: 'h-128 w-auto object-contain animate-balanceio',
        }) %>
      </button>
    </div>

  </main>

  <%- include('../partials/ui/sidebar-direita', {
      sequencia: colmeia.sequencia,
  }) %>

</div>