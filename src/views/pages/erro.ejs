  <main class="mx-auto max-w-3xl px-6 py-16">
    <div class="rounded-favo bg-cera p-6 shadow-painel sm:p-10">
      <%# Interpolação escapada: nada que veio da requisição vira HTML. Aqui só
          chegam mensagens de domínio ou texto fixo, nunca stack nem caminho. %>
      <h1 class="mt-2 font-display text-3xl text-tinta sm:text-4xl"><%= tituloAmigavel %></h1>
      <p class="mt-4 text-lg text-tinta"><%= mensagem %></p>
      <p class="mt-2 text-sm text-tinta-suave"><%= dica %></p>

      <div class="mt-8 flex flex-wrap gap-3">
        <%- include('../partials/ui/botao', { texto: logado ? 'Voltar ao painel' : 'Voltar para o início', href: voltarPara }) %>
        <% if (logado) { %>
          <%- include('../partials/ui/botao', { texto: 'Ir para o início', href: '/', variante: 'secundario' }) %>
        <% } %>
      </div>

      <%# O id da requisição é o que a pessoa consegue nos passar para acharmos
          esta falha exata no log. Como o stack ficou só no servidor, é a única
          pista disponível — e não é dado sensível. %>
      <% if (typeof requestId !== 'undefined' && requestId) { %>
        <p class="mt-8 text-xs text-tinta-suave">
          Se precisar de ajuda, informe este código: <code class="font-mono"><%= requestId %></code>
        </p>
      <% } %>
    </div>
  </main>
