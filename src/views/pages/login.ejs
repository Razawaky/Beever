  <div class="flex min-h-screen flex-col md:flex-row">
    <div class="relative isolate hidden flex-1 flex-col items-center justify-center overflow-hidden bg-ambar p-8 md:flex">
      <div class="login-favos camada-de-favos camada-meio favos-de-fundo" aria-hidden="true"></div>
      <%- include('../partials/ui/mascote', { pose: 'come_here', decorativa: true, classe: 'relative z-10 h-auto w-3/4 max-w-full mascote-stroke' }) %>
      <img
        src="/img/logos/beever_logo_black.webp"
        alt="Beever"
        width="1028"
        height="326"
        class="absolute bottom-24 z-10 h-auto w-48 mascote-stroke"
      />
    </div>

    <div class="flex flex-1 items-center justify-center p-8">
      <div class="w-full max-w-sm">
        <a href="/" class="text-sm text-tinta-suave hover:text-tinta">&larr; Voltar</a>

        <h1 class="mt-6 text-3xl font-bold">Entrar</h1>
        <p class="mt-2 text-tinta-suave">Digite seu e-mail e senha para entrar na conta.</p>

        <% if (senhaAlterada) { %>
          <p role="status" class="mt-6 rounded-favo border border-linha bg-cera p-4 text-sm">
            Senha alterada. Agora é só entrar com a senha nova.
          </p>
        <% } %>

        <% if (contaExcluida) { %>
          <p role="status" class="mt-6 rounded-favo border border-linha bg-cera p-4 text-sm">
            Sua conta foi desativada e você saiu do jogo. Ela será apagada definitivamente depois de
            15 dias.
          </p>
        <% } %>

        <% if (locals.erro) { %>
          <%- include('../partials/ui/aviso-de-erro') %>
        <% } %>

        <form method="POST" action="/sessao/login" class="mt-8 space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div>
            <label for="email" class="mb-1 block text-sm font-medium">E-mail</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="nome@exemplo.com"
              value="<%= locals.email || '' %>"
              aria-invalid="<%= Boolean(locals.erroDeEmail) %>"
              <% if (locals.mensagemEmail) { %>aria-describedby="email-erro"<% } %>
              class="w-full rounded-lg border <%= locals.erroDeEmail ? 'border-erro focus:border-erro' : 'border-linha focus:border-mel' %> px-4 py-3 text-sm focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
            />
            <% if (locals.mensagemEmail) { %>
              <p id="email-erro" class="mt-1 text-xs font-medium text-erro-texto"><%= mensagemEmail %></p>
            <% } %>
          </div>

          <div>
            <label for="senha" class="mb-1 block text-sm font-medium">Senha</label>
            <input
              id="senha"
              name="senha"
              type="password"
              required
              autocomplete="current-password"
              placeholder="Sua senha"
              aria-invalid="<%= Boolean(locals.erroDeSenha) %>"
              <% if (locals.mensagemSenha) { %>aria-describedby="senha-erro"<% } %>
              class="w-full rounded-lg border <%= locals.erroDeSenha ? 'border-erro focus:border-erro' : 'border-linha focus:border-mel' %> px-4 py-3 text-sm focus:outline-[3px] focus:outline-ambar focus:outline-offset-2 focus:ring-2 focus:ring-tinta"
            />
            <% if (locals.mensagemSenha) { %>
              <p id="senha-erro" class="mt-1 text-xs font-medium text-erro-texto"><%= mensagemSenha %></p>
            <% } %>
            <a href="/recuperar-senha" class="mt-2 inline-block text-sm text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Esqueceu a senha?</a>
          </div>

          <%- include('../partials/ui/botao', { texto: 'Entrar', tipo: 'submit', classe: 'w-full' }) %>
        </form>

        <% if (googleConfigurado) { %>
          <%- include('../partials/ui/botao-google', { texto: 'Entrar com Google' }) %>
        <% } %>

        <p class="mt-6 text-center text-sm text-tinta-suave">
          Não tem uma conta?
          <a href="/cadastro" class="font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Cadastre-se</a>
        </p>
      </div>
    </div>
  </div>
