<%#
  Seção 6: o diferencial do produto. Comprar não é o fim do jogo — o que a
  criança compra passa a se comportar como no mundo real: um bem perde valor,
  outro ganha, outro dá renda e cobra manutenção.
-%>
<section id="economia" class="border-t border-white/10 bg-breu py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="revela font-display text-3xl text-cera sm:text-4xl">
      Aqui, comprar não é o fim do jogo
    </h2>

    <p class="revela revela-atrasada mt-5 max-w-2xl text-lg text-cera/80">
      Cada item se comporta como no mundo real. É a diferença entre gastar e investir,
      aprendida gastando dinheiro de brincadeira.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <%
        const COMPORTAMENTOS = [
          {
            icone: '🚗',
            titulo: 'Perde valor',
            exemplo: 'O carro vale menos a cada semana. Comprar cedo demais custa caro.',
          },
          {
            icone: '🏠',
            titulo: 'Ganha valor',
            exemplo: 'A casa valoriza. Esperar para comprar ela é uma decisão, não uma punição.',
          },
          {
            icone: '🏪',
            titulo: 'Dá renda',
            exemplo: 'O negócio paga toda semana — e cobra manutenção, como na vida.',
          },
        ];
      %>
      <% COMPORTAMENTOS.forEach((comportamento) => { %>
        <article class="revela rounded-favo border border-white/10 bg-white/5 p-6">
          <%# Ícone e palavra juntos: cor sozinha não informa (RNF-25). -%>
          <p class="text-3xl" aria-hidden="true"><%= comportamento.icone %></p>
          <h3 class="mt-3 font-display text-xl text-mel"><%= comportamento.titulo %></h3>
          <p class="mt-2 text-cera/70"><%= comportamento.exemplo %></p>
        </article>
      <% }); %>
    </div>

    <div class="revela mt-12 flex flex-col items-start gap-4 rounded-favo border border-white/10 bg-white/5 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm uppercase tracking-widest text-cera/60">Patrimônio de exemplo</p>
        <p
          class="font-display text-4xl tabular-nums text-mel"
          data-contador="3400"
          data-contador-sufixo=" de mel"
        >
          3.400 de mel
        </p>
        <p class="mt-2 text-sm text-cera/70">
          Carteira, cofre e bens somados — a conta que o jogo mostra toda semana.
        </p>
      </div>

      <%- include('../ui/botao', { texto: 'Começar a construir', href: '/cadastro' }) %>
    </div>
  </div>
</section>
