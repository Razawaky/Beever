<%#
  Sidebar Direita da Colmeia.
  Fica fixa no canto direito em telas grandes (lg).
-%>
<aside class="z-20 flex h-full w-72 shrink-0 flex-col gap-6 overflow-y-auto bg-mel p-6 shadow-xl">

  <%# Seção: Tarefas de hoje %>
  <section class="flex flex-col gap-3">
    <h2 class="font-display text-lg text-tinta">Suas tarefas de hoje</h2>

    <% if (colmeia.tarefas.length === 0) { %>
      <p class="text-xs text-tinta-suave">Nenhuma tarefa por enquanto. A colmeia propõe as do dia quando você entra.</p>
    <% } else { %>
      <ul class="grid gap-2">
        <% colmeia.tarefas.forEach((tarefa) => { %>
          <%- include('./card-tarefa', { tarefa, compacto: true, voltarPara: '/painel' }) %>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <%# Seção: Meta mais próxima %>
  <section class="flex flex-col gap-3">
    <h2 class="font-display text-lg text-tinta">Sua meta mais próxima</h2>

    <% if (!colmeia.metaEmDestaque) { %>
      <%- include('./estado-vazio', {
        mensagem: 'Suas metas aparecem assim que a colmeia montar seu plano.',
        acao: { href: '/metas', texto: 'Ver metas e tarefas' },
      }) %>
    <% } else { %>
      <%- include('./card-meta', { meta: colmeia.metaEmDestaque, destaque: true }) %>

      <% if (colmeia.outrasMetas.length > 0) { %>
        <h3 class="mt-2 text-xs font-semibold uppercase tracking-wide text-tinta-suave">Suas outras metas</h3>
        <ul class="grid gap-2">
          <% colmeia.outrasMetas.forEach((meta) => { %>
            <li class="flex flex-col gap-1 rounded-favo bg-cera p-3 text-xs">
              <span class="font-medium text-tinta"><%= meta.titulo %></span>
              <span class="tabular-nums text-tinta-suave">
                <%= meta.percentual %>% · <%= meta.urgencia.icone %> <%= meta.urgencia.frase %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <p class="text-right">
        <a href="/metas" class="text-xs font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver todas as metas &rarr;</a>
      </p>
    <% } %>
  </section>

  <%# Seção: Seus Itens / Patrimônio %>
  <section class="rounded-favo bg-cera p-6">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-base font-semibold text-tinta">Seus itens</h2>
      <a href="/inventario" class="text-xs font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver todos &rarr;</a>
    </div>
    
    <div class="rounded-lg bg-white p-4">
      <p class="text-xs text-tinta-suave">Patrimônio é tudo o que você tem somado: o mel na carteira, o mel guardado no cofre e o valor dos seus bens.</p>

      <dl class="mt-3 flex flex-col gap-y-2 text-xs tabular-nums">
        <div class="flex justify-between gap-2 border-b border-fundo pb-1">
          <dt class="text-tinta-suave">Na carteira</dt>
          <dd class="font-medium text-tinta"><%= colmeia.jogador.patrimonio.carteira %></dd>
        </div>
        <div class="flex justify-between gap-2 border-b border-fundo pb-1">
          <dt class="text-tinta-suave">No cofre</dt>
          <dd class="font-medium text-tinta"><%= colmeia.jogador.patrimonio.cofre %></dd>
        </div>
        <div class="flex justify-between gap-2">
          <dt class="text-tinta-suave">Em bens</dt>
          <dd class="font-medium text-tinta"><%= colmeia.jogador.patrimonio.bens %></dd>
        </div>
      </dl>
    </div>
  </section>

  <%# Seção: Liga %>
  <section class="rounded-favo bg-cera p-6">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-base font-semibold text-tinta">Sua liga</h2>
      <a href="/liga" class="text-xs font-medium text-tinta underline decoration-ambar decoration-2 underline-offset-4 transition hover:decoration-mel">Ver liga &rarr;</a>
    </div>

    <% if (!colmeia.liga || colmeia.liga.posicao === null) { %>
      <p class="text-xs text-tinta-suave">Ganhe seu primeiro pólen da semana e você entra no ranque do seu grupo.</p>
    <% } else { %>
      <p class="text-xs tabular-nums text-tinta">
        Você está em <strong><%= colmeia.liga.posicao %>º lugar</strong> no <%= colmeia.liga.grupo.nome %>,
        com 🌼 <%= colmeia.liga.polen %> de pólen. Ninguém desce de liga.
      </p>
    <% } %>
  </section>
</aside>

