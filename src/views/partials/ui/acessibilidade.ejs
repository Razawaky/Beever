<%#
  Painel de acessibilidade, presente em toda tela.

  O modo normal é o padrão: enquanto ninguém liga nada aqui, a página é
  exatamente a que foi desenhada — mesma cor, mesma imagem, mesma animação,
  mesma navegação, mesmo tamanho de texto. Cada ajuste é uma escolha, e o botão
  "Ativar tudo" liga os quatro de uma vez.

  Nasce escondido e só aparece quando o script roda, porque é ele que guarda a
  escolha no navegador.
-%>
<div id="acessibilidade" class="fixed bottom-4 right-4 z-40 print:hidden">
  <button
    type="button"
    id="acessibilidade-abrir"
    class="flex min-h-12 min-w-12 items-center justify-center rounded-pilula bg-mel px-4 text-tinta shadow-elevado transition hover:bg-nectar focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2 focus-visible:ring-2 focus-visible:ring-tinta"
    aria-expanded="false"
    aria-controls="acessibilidade-painel"
  >
    <span class="text-xl" aria-hidden="true">♿</span>
    <span class="ml-2 hidden text-sm font-semibold sm:inline">Acessibilidade</span>
    <span class="sr-only">Abrir opções de acessibilidade</span>
  </button>

  <div
    id="acessibilidade-painel"
    class="mt-3 hidden w-72 rounded-favo border border-linha bg-white p-4 text-tinta shadow-painel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="acessibilidade-titulo"
  >
    <h2 id="acessibilidade-titulo" class="font-display text-lg">Acessibilidade</h2>
    <p class="mt-1 text-sm text-tinta-suave">
      Sem nada ligado, a página fica do jeito normal. Escolha o que ajudar você.
    </p>

    <ul class="mt-4 space-y-2">
      <%
        const AJUSTES = [
          {
            chave: 'movimento',
            titulo: 'Reduzir movimento',
            explicacao: 'Para a animação e a rolagem suave.',
          },
          {
            chave: 'contraste',
            titulo: 'Aumentar contraste',
            explicacao: 'Escurece o texto de apoio e engrossa o foco.',
          },
          {
            chave: 'texto',
            titulo: 'Texto maior',
            explicacao: 'Aumenta tudo, sem quebrar o layout.',
          },
          {
            chave: 'distracao',
            titulo: 'Menos distração',
            explicacao: 'Esconde fundo animado e ilustração de enfeite.',
          },
        ];
      %>
      <% AJUSTES.forEach((ajuste) => { %>
        <li>
          <%# Botão com `aria-pressed` em vez de checkbox: é uma chave que liga e
              desliga na hora, e o leitor de tela anuncia o estado. -%>
          <button
            type="button"
            class="acessibilidade-chave flex min-h-12 w-full items-start gap-3 rounded-favo border border-linha px-3 py-2 text-left transition hover:bg-cera focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2 aria-pressed:border-mel aria-pressed:bg-mel/10"
            data-ajuste="<%= ajuste.chave %>"
            aria-pressed="false"
          >
            <span class="acessibilidade-marca mt-0.5 text-lg" aria-hidden="true">☐</span>
            <span>
              <span class="block text-sm font-semibold"><%= ajuste.titulo %></span>
              <span class="block text-xs text-tinta-suave"><%= ajuste.explicacao %></span>
            </span>
          </button>
        </li>
      <% }); %>
    </ul>

    <div class="mt-4 flex gap-2">
      <button
        type="button"
        id="acessibilidade-tudo"
        class="min-h-11 flex-1 rounded-favo bg-mel px-3 py-2 text-sm font-semibold text-tinta transition hover:bg-nectar focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        Ativar tudo
      </button>
      <button
        type="button"
        id="acessibilidade-normal"
        class="min-h-11 flex-1 rounded-favo border border-linha px-3 py-2 text-sm font-semibold text-tinta transition hover:bg-cera focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        Modo normal
      </button>
    </div>

    <p id="acessibilidade-aviso" class="mt-3 text-xs text-tinta-suave" role="status" aria-live="polite">
      Modo normal.
    </p>
  </div>
</div>
