<%#
  Card da meta (RF-HOM-04 e RF-MET-02). Recebe a meta já resumida pelo
  `goalsService`: percentual, prazo em palavra e recompensa chegam prontos.

  A ação fica de fora, logo abaixo do include, porque ela muda de tela para
  tela: a Colmeia leva para /metas, e /metas conclui, retoma ou não oferece nada.
  `destaque` deixa o card maior, para a meta que vence primeiro.
  `compacto` mostra só título, prazo e barra de progresso (ex.: sidebar).
-%>
<%
  const compacto = Boolean(locals.compacto);
%>
<article class="rounded-favo bg-white shadow-md <%= compacto ? 'p-4' : 'p-6' %>">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h3 class="<%= locals.destaque ? (compacto ? 'font-display text-lg' : 'font-display text-xl') : 'text-lg font-bold' %> <%= meta.status === 'concluida' ? 'text-tinta-suave line-through' : 'text-tinta' %>">
        <%= meta.titulo %>
      </h3>
      <% if (!compacto) { %>
        <p class="mt-1 text-sm tabular-nums text-tinta-suave"><%= meta.atual %> de <%= meta.alvo %></p>
      <% } %>
      <% if (!compacto && locals.mostrarDetalhes) { %>
        <p class="mt-1 text-xs text-tinta-suave">
          <%= meta.status %> · dificuldade <%= meta.dificuldade %>
        </p>
      <% } %>
    </div>

    <%# Ícone e palavra juntos: cor sozinha não anuncia urgência (RNF-25). %>
    <p class="inline-flex items-center gap-1.5 font-semibold tabular-nums <%= compacto ? 'text-xs' : 'text-sm' %> <%= meta.urgencia.nivel === 'hoje' ? 'text-erro-texto' : 'text-tinta' %>">
      <%- svgIcone(meta.urgencia.icone, 'h-4 w-4') %> <%= meta.urgencia.frase %>
    </p>
  </div>

  <div class="<%= compacto ? 'mt-3' : 'mt-4' %>">
    <%- include('barra-progresso', {
      percentual: meta.percentual,
      rotuloAcessivel: `Progresso da meta ${meta.titulo}`,
      legenda: compacto ? null : `${meta.percentual}% concluído`,
    }) %>
  </div>

  <% if (!compacto) { %>
    <%# Recompensa zerada não é escrita: "e 0 de pólen" só ocupa espaço. %>
    <p class="mt-3 text-sm tabular-nums">
      Rende <%- svgIcone('mel', 'h-4 w-4') %> <%= meta.melDaRecompensa %> de mel<% if (meta.polenDaRecompensa > 0) { %> e <%- svgIcone('polen', 'h-4 w-4') %> <%= meta.polenDaRecompensa %> de pólen<% } %>
    </p>
  <% } %>
</article>
