<%#
  Card do item na vitrine (RF-LOJ-03). O comportamento econômico é escrito em
  frase, não em jargão: a criança precisa entender o que o item faz com o mel
  dela antes de gastar. Os números já vêm respondidos pelo `shopService`, com a
  regra da faixa aplicada (RN-038).
%>
<article class="flex flex-col justify-between rounded-favo bg-white p-6 shadow-md">
  <div>
    <span class="text-xs font-semibold uppercase tracking-wide text-tinta-suave"><%= item.category_name %></span>
    <h3 class="mt-1 text-lg font-bold"><%= item.name %></h3>
    <p class="mt-2 text-sm text-tinta-suave"><%= item.description_kid %></p>

    <ul class="mt-4 grid gap-1 text-sm tabular-nums">
      <% if (item.perdeValor) { %>
        <li>📉 Perde valor toda semana</li>
      <% } else if (Number(item.valuation_rate) > 0) { %>
        <li>📈 Vale mais a cada semana</li>
      <% } %>
      <% if (item.custoSemanal > 0) { %>
        <li>💸 Custa <%= item.custoSemanal %> de mel por semana</li>
      <% } %>
      <% if (item.rendaSemanal > 0) { %>
        <li>🍯 Rende <%= item.rendaSemanal %> de mel por semana</li>
      <% } %>
      <% if (!item.counts_in_patrimony) { %>
        <li>✨ Enfeite: isso não aumenta seu patrimônio</li>
      <% } %>
      <% if (item.avisoDaFaixa) { %>
        <li class="text-tinta-suave"><%= item.avisoDaFaixa %></li>
      <% } %>
    </ul>

    <% if (item.quantidadePossuida > 0) { %>
      <p class="mt-3 text-sm font-medium">Você já tem <%= item.quantidadePossuida %></p>
    <% } %>

    <% if (item.bloqueios.length > 0) { %>
      <ul class="mt-3 grid gap-1 text-sm text-tinta-suave">
        <% item.bloqueios.forEach((bloqueio) => { %>
          <li>🔒 <%= bloqueio.mensagem %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="mt-6 flex items-end justify-between gap-4">
    <div>
      <% if (item.troca) { %>
        <p class="text-xs tabular-nums text-tinta-suave">
          Entregando <%= item.troca.itemTrocado %>: −<%= item.troca.desconto %>
        </p>
      <% } %>
      <p class="text-lg font-semibold tabular-nums">🍯 <%= item.precoComDesconto %></p>
      <% if (!item.podeComprar && item.bloqueios.length === 0) { %>
        <p class="text-xs tabular-nums text-tinta-suave">faltam <%= item.faltamDeMel %> de mel</p>
      <% } %>
    </div>

    <% if (item.bloqueios.length > 0) { %>
      <span class="rounded-pilula bg-cera px-4 py-2 text-sm font-medium text-tinta-suave">Ainda não</span>
    <% } else { %>
      <%# O botão leva para a confirmação, nunca direto para a compra: a criança
          vê o impacto antes de gastar (RF-LOJ-05). %>
      <%- include('./botao', {
        texto: 'Quero este',
        href: `/loja/itens/${item.id}/confirmar`,
        tamanho: 'medio',
        rotuloAcessivel: `Quero ${item.nome}`,
      }) %>
    <% } %>
  </div>
</article>
