<%#
  O topo da Colmeia (RF-HOM-01 a 03). Fica grudado ao rolar porque é a resposta
  de "onde eu estou": o saldo precisa estar à vista justamente quando a criança
  decide gastar. Todos os números já chegam prontos do `homeService`.
-%>
<header class="sticky top-0 z-10 bg-mel px-6 py-4 shadow-md">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-8 gap-y-4">
    <div class="flex items-center gap-3">
      <div class="flex h-12 w-12 items-center justify-center rounded-pilula bg-white/40 text-xl font-bold">
        <%= jogador.apelido.charAt(0).toUpperCase() %>
      </div>
      <div class="min-w-[9rem]">
        <p class="font-bold text-tinta"><%= jogador.apelido %></p>
        <p class="text-xs font-semibold uppercase tracking-wide text-tinta-suave">
          Nível <%= jogador.nivel?.nivel ?? 1 %>
        </p>
        <div class="mt-1 w-40">
          <%- include('barra-progresso', {
            percentual: jogador.nivel?.progressoPercentual ?? 0,
            rotuloAcessivel: 'Progresso até o próximo nível',
            classeDoTrilho: 'bg-white/40',
            classeDoPreenchimento: 'bg-breu',
            legenda: jogador.nivel?.noTopo
              ? 'Nível máximo alcançado'
              : `faltam ${jogador.nivel?.xpParaSubir ?? 0} XP para o nível ${(jogador.nivel?.nivel ?? 1) + 1}`,
          }) %>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-start gap-x-8 gap-y-4">
      <%- include('badge-recurso', {
        icone: '🍯',
        rotulo: 'Seu mel',
        valor: jogador.mel,
        grande: true,
        detalhe: `🌼 ${jogador.polen} de pólen`,
      }) %>

      <%- include('badge-recurso', {
        icone: '🏠',
        rotulo: 'Seu patrimônio',
        valor: jogador.patrimonio.total,
        grande: true,
        detalhe: `carteira ${jogador.patrimonio.carteira} · cofre ${jogador.patrimonio.cofre} · bens ${jogador.patrimonio.bens}`,
      }) %>
    </div>

    <%# A sequência leva ao calendário completo em /metas, e usa o mesmo partial
        da semana: dois desenhos do mesmo dado divergem no primeiro ajuste. %>
    <a
      href="/metas"
      class="rounded-favo px-2 py-1 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
    >
      <p class="text-sm font-semibold tabular-nums text-tinta">
        🔥 <%= sequencia.diasAtuais %> <%= sequencia.diasAtuais === 1 ? 'dia seguido' : 'dias seguidos' %>
      </p>
      <div class="mt-2">
        <%- include('calendario-semana', { semana: sequencia, compacto: true }) %>
      </div>
    </a>
  </div>
</header>
