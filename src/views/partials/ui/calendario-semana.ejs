<%#
  Calendário da semana da sequência (RF-SEQ-02).

  Recebe `semana` pronta do `streakService.resumoDaSemana` e um `compacto` para a
  faixa do painel. A view não cruza agenda com evento, só escolhe a aparência.
-%>
<%
  const APARENCIAS = {
    cumprido:  { fundo: 'bg-mel',    texto: 'text-tinta',        rotulo: 'cumprido' },
    perdido:   { fundo: 'bg-erro',   texto: 'text-white',        rotulo: 'perdido' },
    protegido: { fundo: 'bg-ambar',  texto: 'text-tinta',        rotulo: 'salvo pelo escudo' },
    neutro:    { fundo: 'bg-linha',  texto: 'text-tinta-suave',  rotulo: 'dia de folga' },
  };

  function aparenciaDoDia(dia) {
    if (dia.desfecho) return APARENCIAS[dia.desfecho];
    if (!dia.marcado) return { fundo: 'bg-cera', texto: 'text-tinta-suave', rotulo: 'dia de folga' };
    if (dia.ehHoje) return { fundo: 'bg-white', texto: 'text-tinta', rotulo: 'ainda dá tempo hoje' };
    return { fundo: 'bg-white', texto: 'text-tinta-suave', rotulo: 'dia marcado, ainda vem' };
  }

  function diaEMes(data) {
    return `${data.slice(8, 10)}/${data.slice(5, 7)}`;
  }
-%>

<div class="grid grid-cols-7 gap-1.5 <%= compacto ? 'max-w-xs' : '' %>">
  <% semana.dias.forEach((dia) => { %>
    <% const aparencia = aparenciaDoDia(dia); %>
    <div class="flex flex-col items-center gap-1">
      <span class="text-xs font-semibold uppercase text-tinta-suave"><%= dia.nome.slice(0, 3) %></span>
      <div
        class="flex items-center justify-center rounded-pilula border-2 <%= aparencia.fundo %> <%= aparencia.texto %> <%= dia.marcado && !dia.desfecho ? 'border-dashed border-linha' : 'border-transparent' %> <%= dia.ehHoje ? 'ring-2 ring-tinta ring-offset-1' : '' %> <%= compacto ? 'h-7 w-7' : 'h-10 w-10' %>"
        role="img"
        aria-label="<%= dia.nome %>, <%= diaEMes(dia.data) %> — <%= aparencia.rotulo %>"
      >
        <% if (dia.desfecho === 'cumprido') { %>
          <svg class="<%= compacto ? 'h-4 w-4' : 'h-5 w-5' %>" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M9.5 17.6l-5.1-5.1 1.8-1.8 3.3 3.3 8.3-8.3 1.8 1.8z" />
          </svg>
        <% } else if (dia.desfecho === 'perdido') { %>
          <svg class="<%= compacto ? 'h-4 w-4' : 'h-5 w-5' %>" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M18.3 7.5l-1.8-1.8L12 10.2 7.5 5.7 5.7 7.5l4.5 4.5-4.5 4.5 1.8 1.8 4.5-4.5 4.5 4.5 1.8-1.8-4.5-4.5z" />
          </svg>
        <% } else if (dia.desfecho === 'protegido') { %>
          <svg class="<%= compacto ? 'h-4 w-4' : 'h-5 w-5' %>" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 2l8 3v6c0 5-3.4 9.2-8 11-4.6-1.8-8-6-8-11V5l8-3zm0 4.2L7 8v3c0 3.4 2 6.4 5 7.8 3-1.4 5-4.4 5-7.8V8l-5-1.8z" />
          </svg>
        <% } else { %>
          <span class="text-xs font-semibold"><%= Number(dia.data.slice(8, 10)) %></span>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

<% if (!compacto) { %>
  <%# RNF-25: o estado nunca é só a cor — cada desfecho vem escrito por extenso. %>
  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-tinta-suave">
    <li class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-pilula bg-mel"></span>cumprido</li>
    <li class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-pilula bg-erro"></span>perdido</li>
    <li class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-pilula bg-ambar"></span>salvo pelo escudo</li>
    <li class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-pilula bg-linha"></span>dia de folga</li>
    <li class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-pilula border-2 border-dashed border-linha bg-white"></span>ainda vem</li>
  </ul>
<% } %>
