<%#
  Um número do jogador com ícone e palavra (regra 5 da seção 4 do design
  system): só ícone é ilegível para quem tem 6 anos, só palavra é apagado
  demais para quem tem 15. O valor é tabular para não dançar quando muda.

  Recebe `icone` (nome do SVG em `/js/icones.js`), `rotulo` e `valor`; `grande`
  para os números que a tela quer maiores (saldo, patrimônio) e `detalhe` para a
  linha pequena embaixo. O detalhe aceita texto ou `{ icone, texto }`.
-%>
<div class="grid gap-0.5">
  <p class="text-xs font-semibold uppercase tracking-wide text-tinta-suave"><%= rotulo %></p>
  <%# O ícone fica ao lado do número, e não como elemento separado: o rótulo
      acima já diz a palavra, e separar os dois quebraria o par de valor. %>
  <p class="<%= locals.grande ? 'text-3xl' : 'text-lg' %> flex items-center gap-2 font-bold tabular-nums text-tinta">
    <%- svgIcone(icone, locals.grande ? 'h-8 w-8' : 'h-5 w-5') %>
    <span><%= valor %></span>
  </p>
  <% if (locals.detalhe) { %>
    <p class="flex items-center gap-1.5 text-xs tabular-nums text-tinta-suave">
      <% if (locals.detalhe.icone) { %><%- svgIcone(detalhe.icone, 'h-4 w-4') %><% } %>
      <span><%= locals.detalhe.texto ?? detalhe %></span>
    </p>
  <% } %>
</div>
