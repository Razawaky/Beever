<%#
  A lateral da Colmeia (RF-HOM-01 a 03). Fica fixa no canto esquerdo da tela
  para que o saldo e o perfil do jogador estejam sempre visíveis.
-%>
<aside class="fixed inset-y-0 left-0 z-20 flex w-72 flex-col justify-between h-full overflow-hidden bg-mel p-6 shadow-xl">
  <div class="flex flex-col gap-6">
    <%# Perfil do Jogador %>
    <div class="flex items-center gap-3 border-b border-tinta/10 pb-6">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-pilula bg-white/40 text-xl font-bold">
        <%= jogador.apelido.charAt(0).toUpperCase() %>
      </div>
      <div class="min-w-0 flex-1">
        <h1 class="truncate text-lg font-bold text-tinta"><%= jogador.apelido %></h1>
        <p class="text-xs font-semibold uppercase tracking-wide text-tinta-suave">
          Nível <%= jogador.nivel?.nivel ?? 1 %>
        </p>
        <div class="mt-2 w-full">
          <%- include('barra-progresso', {
            percentual: jogador.nivel?.progressoPercentual ?? 0,
            rotuloAcessivel: 'Progresso até o próximo nível',
            classeDoTrilho: 'bg-white/40',
            classeDoPreenchimento: 'bg-breu',
            legenda: jogador.nivel?.noTopo
              ? 'Nível máximo alcançado'
              : `faltam ${jogador.nivel?.xpParaSubir ?? 0} XP para o nível ${(jogador.nivel?.nivel ?? 1) + 1}`,
          }) %>
        </div>
      </div>
    </div>

    <%# Recurso: Mel %>
    <div class="flex flex-col gap-4">
      <%- include('badge-recurso', {
        icone: '🍯',
        rotulo: 'Seu mel',
        valor: jogador.mel,
        grande: true,
        detalhe: `🌼 ${jogador.polen} de pólen`,
      }) %>

      <%# Recurso: Patrimônio %>
      <%- include('badge-recurso', {
        icone: '🏠',
        rotulo: 'Seu patrimônio',
        valor: jogador.patrimonio.total,
        grande: true,
        detalhe: `carteira ${jogador.patrimonio.carteira} · cofre ${jogador.patrimonio.cofre} · bens ${jogador.patrimonio.bens}`,
      }) %>
    </div>

    <%# Menu de Navegação / Atalhos %>
    <nav class="mt-2 flex flex-col gap-2">
      <a
        href="loja"
        hx-get="/painel/loja"
        hx-target="#conteudo-main"
        hx-swap="innerHTML"
        hx-push-url="true"
        class="flex items-center gap-3 rounded-favo bg-cera px-4 py-3 font-semibold text-tinta transition hover:bg-white/50 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        <span class="text-xl">🛒</span>
        <span>Ir para a loja</span>
      </a>
      <a
        href="/cofre"
        hx-get="/painel/cofre"
        hx-target="#conteudo-main"
        hx-swap="innerHTML"
        hx-push-url="true"
        class="flex items-center gap-2 rounded-favo bg-cera px-4 py-3 font-semibold text-tinta transition hover:bg-white/50 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        <span>🏦</span>
        <span>Meu cofre</span>
      </a>
      <a
        href="/conquistas"
        hx-get="/painel/conquistas"
        hx-target="#conteudo-main"
        hx-swap="innerHTML"
        hx-push-url="true"
        class="flex items-center gap-2 rounded-favo bg-cera px-4 py-3 font-semibold text-tinta transition hover:bg-white/50 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
      >
        <span>🏆</span>
        <span>Minhas conquistas</span>
      </a>
      <% if (mostrarAtalhoAdmin) { %>
        <a
          href="/admin"
          hx-get="/painel/admin"
          hx-target="#conteudo-main"
          hx-swap="innerHTML"
          hx-push-url="true"
          class="flex items-center gap-2 rounded-favo bg-cera px-4 py-3 font-semibold text-tinta transition hover:bg-white/50 focus-visible:outline-[3px] focus-visible:outline-ambar focus-visible:outline-offset-2"
        >
          <span>⚙️</span>
          <span>Área administrativa</span>
        </a>
      <% } %>
    </nav>

  </div>

  <div class="border-t border-tinta/10 px-8 py-6">
    <form method="POST" action="/sessao/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <%# `inline-flex` para a altura de 44 px valer sem esticar a linha inteira. -%>
      <button type="submit" class="inline-flex min-h-11 items-center text-sm font-medium text-tinta-suave hover:text-tinta">
        Sair da conta
      </button>
    </form>
  </div>

</aside>