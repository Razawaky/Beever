<%#
  Área do Cofre do Tempo (RF-JOG-04): um ciclo por vez, e o gráfico crescendo a
  cada depósito. Quem preenche é o `cofre.js`; a casca em volta é a
  `pages/celula.ejs`.

  O gráfico é um SVG montado na página, com barras posicionadas por atributo de
  geometria — a CSP não permite `style` inline, e trazer biblioteca de gráfico
  para quatro barras seria dependência a mais no MVP. A cor vem de
  `currentColor`, então quem manda nela é a classe do grupo.

  O gráfico não carrega informação sozinho (RNF-25): abaixo dele a mesma coisa
  aparece em tabela, que é o que o leitor de tela lê.
-%>
<h2 id="cofre-enunciado" tabindex="-1" class="mt-6 font-display text-xl text-tinta" aria-live="polite"></h2>

<figure class="mt-5">
  <svg
    id="cofre-grafico"
    viewBox="0 0 120 70"
    class="h-40 w-full text-mel"
    role="img"
    aria-labelledby="cofre-grafico-titulo"
  >
    <title id="cofre-grafico-titulo">Saldo do cofre a cada ciclo</title>
    <line id="cofre-linha-da-meta" x1="0" y1="10" x2="120" y2="10" stroke="currentColor" stroke-width="0.5"
      stroke-dasharray="2 2" class="text-tinta-suave" />
    <g id="cofre-barras"></g>
  </svg>
  <figcaption id="cofre-legenda" class="mt-2 text-center text-sm text-tinta-suave"></figcaption>
</figure>

<table class="mt-4 w-full text-left text-sm">
  <caption class="sr-only">Depósito e saldo do cofre em cada ciclo</caption>
  <thead>
    <tr class="text-tinta-suave">
      <th scope="col" class="py-1">Ciclo</th>
      <th scope="col" class="py-1">Guardado</th>
      <th scope="col" class="py-1 text-right">Saldo</th>
    </tr>
  </thead>
  <tbody id="cofre-historico"></tbody>
</table>

<div id="cofre-rodada" class="mt-6 rounded-favo border-2 border-linha bg-white p-4">
  <p id="cofre-pergunta" class="font-semibold text-tinta"></p>
  <p id="cofre-regra" class="text-sm text-tinta-suave"></p>

  <div class="mt-3 flex items-center justify-between gap-3">
    <button
      id="cofre-tirar"
      type="button"
      class="h-11 w-11 shrink-0 rounded-pilula border-2 border-linha bg-white font-display text-xl text-tinta transition hover:border-ambar focus-visible:outline-[3px] focus-visible:outline-tinta focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-40"
      aria-label="Guardar menos"
    >
      &minus;
    </button>
    <p id="cofre-deposito" class="min-w-16 text-center font-display text-2xl text-tinta tabular-nums"></p>
    <button
      id="cofre-colocar"
      type="button"
      class="h-11 w-11 shrink-0 rounded-pilula border-2 border-linha bg-white font-display text-xl text-tinta transition hover:border-ambar focus-visible:outline-[3px] focus-visible:outline-tinta focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-40"
      aria-label="Guardar mais"
    >
      +
    </button>
  </div>
</div>

<%- include('../ui/botao', { texto: 'Guardar', id: 'cofre-confirmar', classe: 'mt-6 w-full' }) %>
