<main class="demo">
  <section class="demo__palco relative" aria-label="Protótipo do quarto do Beenie">
    <div class="demo__hud" hidden>
      <p class="demo__hud-titulo">Quarto do Beenie</p>
    </div>

    <div class="demo__midia">
      <div id="video-camada" class="video-camada">
        <video
          id="video-intro"
          class="video"
          poster="/demo/quarto-beenie/poster.png"
          preload="auto"
          playsinline
          aria-label="Introdução do Quarto do Beenie"
        >
          <source src="/demo/quarto-beenie/intro.mp4" type="video/mp4" />
          <source src="/demo/quarto-beenie/intro.webm" type="video/webm" />
          Seu navegador não suporta vídeo em HTML5.
        </video>

        <button
          id="video-tocar"
          class="video__play"
          type="button"
          aria-label="Reproduzir introdução com áudio"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5.5v13l11-6.5L8 5.5Z" fill="currentColor" stroke="none" />
          </svg>
        </button>

        <button
          id="video-som"
          class="video__som"
          type="button"
          aria-label="Ativar som"
          aria-pressed="false"
          title="Ativar som"
        >
          <svg class="icone-som icone-som--mudo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 9h4l5-4v14l-5-4H4z" />
            <path d="m17 9 5 6m0-6-5 6" />
          </svg>
          <svg class="icone-som icone-som--ligado" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 9h4l5-4v14l-5-4H4z" />
            <path d="M16 9a4 4 0 0 1 0 6" />
            <path d="M18.5 6.5a7.5 7.5 0 0 1 0 11" />
          </svg>
        </button>

        <button id="video-pular" class="video__pular" type="button">Pular vídeo</button>
      </div>

      <div id="jogo" class="demo__canvas" hidden></div>
    </div>

    <div id="quarto-resultado-recompensas" class="pointer-events-none absolute inset-x-0 hidden px-6" aria-live="polite">
      <dl class="mx-auto grid max-w-xs grid-cols-3 gap-2 text-center">
        <div class="rounded-favo bg-cera/95 p-1.5 shadow-elevado sm:p-2">
          <dt class="text-[11px] font-semibold text-tinta-suave">XP</dt>
          <dd id="quarto-resultado-xp" class="font-display text-base leading-tight text-tinta tabular-nums sm:text-lg">0</dd>
        </div>
        <div class="rounded-favo bg-cera/95 p-1.5 shadow-elevado sm:p-2">
          <dt class="text-[11px] font-semibold text-tinta-suave">Pólen</dt>
          <dd id="quarto-resultado-polen" class="font-display text-base leading-tight text-tinta tabular-nums sm:text-lg">0</dd>
        </div>
        <div class="rounded-favo bg-cera/95 p-1.5 shadow-elevado sm:p-2">
          <dt class="text-[11px] font-semibold text-tinta-suave">Mel</dt>
          <dd id="quarto-resultado-mel" class="font-display text-base leading-tight text-tinta tabular-nums sm:text-lg">0</dd>
        </div>
      </dl>
    </div>
  </section>
</main>
