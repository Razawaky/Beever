{
  "name": "beever",
  "version": "1.0.0",
  "description": "Plataforma gamificada de educação financeira para crianças e adolescentes",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "db:reconcile": "node scripts/reconcile.js",
    "db:backup": "node scripts/backup.js",
    "css:build": "tailwindcss -i src/styles/tailwind.css -o src/public/css/app.css --minify",
    "css:watch": "tailwindcss -i src/styles/tailwind.css -o src/public/css/app.css --watch",
    "lint": "eslint .",
    "test": "NODE_ENV=test node --test \"test/**/*.test.js\"",
    "test:db": "TESTES_DE_BANCO=1 NODE_ENV=test node --test \"test/**/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mysql2": "^3.23.3",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3"
  }
}
